+static LRESULT surface_paint( HWND hwnd, UINT action, LPARAM value )
+{
+    struct x11drv_win_data *data;
+    struct window_surface *surface = NULL;
+    Window window = None;
+    BOOL clean;
+    LRESULT result = 0;
+
+    if (!(data = get_win_data( hwnd ))) return 0;
+    if (action == WINE_SURFACE_BEGIN_PAINT)
+    {
+        data->first_present_depth++;
+        goto done;
+    }
+    if (action == WINE_SURFACE_ABORT_PAINT)
+    {
+        if (data->first_present_depth) data->first_present_depth--;
+        goto done;
+    }
+    if (action == WINE_SURFACE_END_PAINT && data->first_present_depth) data->first_present_depth--;
+    if (!data->first_present_surface)
+    {
+        if (!data->first_present_depth && (action == WINE_SURFACE_END_PAINT ||
+            (action == WINE_SURFACE_END_DC && is_window_surface( (struct window_surface *)value, data->whole_window ))))
+            result = -1;
+        goto done;
+    }
+    switch (action)
+    {
+    case WINE_SURFACE_END_PAINT:
+    case WINE_SURFACE_VALIDATE:
+    case WINE_SURFACE_END_DC:
+        if (data->first_present_depth) break;
+        if (action == WINE_SURFACE_END_DC && data->first_present_surface != (struct window_surface *)value) break;
+        if (action == WINE_SURFACE_VALIDATE && data->first_present_replacement) break;
+        data->first_present_ready = TRUE;
+        result = data->first_present_serial;
+        break;
+    case WINE_SURFACE_COMMIT:
+        if ((ULONG)value != data->first_present_serial || !data->first_present_ready) break;
+        surface = data->first_present_surface;
+        window_surface_add_ref( surface );
+        window = data->whole_window;
+        break;
+    }
+done:
+    release_win_data( data );
+    if (!surface) return result;
+    pthread_mutex_lock( &surface->mutex );
+    clean = IsRectEmpty( &surface->bounds );
+    pthread_mutex_unlock( &surface->mutex );
+    if (clean) window_surface_presented( hwnd, window, surface );
+    window_surface_release( surface );
+    return result;
+}
 
