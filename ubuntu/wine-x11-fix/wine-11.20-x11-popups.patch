+#ifdef SONAME_LIBDBUS_1
+#include <dbus/dbus.h>
+
+#define SNI_ITEM "org.kde.StatusNotifierItem"
+#define SNI_WATCHER "org.kde.StatusNotifierWatcher"
+#define SNI_MENU "com.canonical.dbusmenu"
+#define ITEM_PATH "/StatusNotifierItem"
+#define MENU_PATH "/Menu"
+#define SNI_ACTION_ACTIVATE 1
+#define SNI_ACTION_CONTEXT_MENU 2
+#define SNI_ACTION_SECONDARY 3
+
+extern int sni_queue_event( uint64_t token, unsigned int action, int x, int y );
+
+#define DBUS_FUNCS \
+    DO_FUNC(dbus_bus_add_match) \
+    DO_FUNC(dbus_bus_get_private) \
+    DO_FUNC(dbus_bus_name_has_owner) \
+    DO_FUNC(dbus_connection_add_filter) \
+    DO_FUNC(dbus_connection_close) \
+    DO_FUNC(dbus_connection_dispatch) \
+    DO_FUNC(dbus_connection_get_outgoing_size) \
+    DO_FUNC(dbus_connection_get_unix_fd) \
+    DO_FUNC(dbus_connection_read_write) \
+    DO_FUNC(dbus_connection_ref) \
+    DO_FUNC(dbus_connection_register_object_path) \
+    DO_FUNC(dbus_connection_send) \
+    DO_FUNC(dbus_connection_set_exit_on_disconnect) \
+    DO_FUNC(dbus_connection_unref) \
+    DO_FUNC(dbus_error_free) \
+    DO_FUNC(dbus_error_init) \
+    DO_FUNC(dbus_error_is_set) \
+    DO_FUNC(dbus_message_append_args) \
+    DO_FUNC(dbus_message_get_args) \
+    DO_FUNC(dbus_message_get_interface) \
+    DO_FUNC(dbus_message_get_member) \
+    DO_FUNC(dbus_message_get_signature) \
+    DO_FUNC(dbus_message_is_method_call) \
+    DO_FUNC(dbus_message_is_signal) \
+    DO_FUNC(dbus_message_iter_append_basic) \
+    DO_FUNC(dbus_message_iter_append_fixed_array) \
+    DO_FUNC(dbus_message_iter_close_container) \
+    DO_FUNC(dbus_message_iter_get_arg_type) \
+    DO_FUNC(dbus_message_iter_get_basic) \
+    DO_FUNC(dbus_message_iter_init) \
+    DO_FUNC(dbus_message_iter_init_append) \
+    DO_FUNC(dbus_message_iter_next) \
+    DO_FUNC(dbus_message_iter_open_container) \
+    DO_FUNC(dbus_message_iter_recurse) \
+    DO_FUNC(dbus_message_new_error) \
+    DO_FUNC(dbus_message_new_method_call) \
+    DO_FUNC(dbus_message_new_method_return) \
+    DO_FUNC(dbus_message_new_signal) \
+    DO_FUNC(dbus_message_set_no_reply) \
+    DO_FUNC(dbus_message_unref) \
+    DO_FUNC(dbus_threads_init_default)
+
+#define DO_FUNC(func) static typeof(func) *p_##func;
+DBUS_FUNCS
+#undef DO_FUNC
+
+struct sni_item
+{
+    struct sni_item *next;
+    uint64_t token;
+    char *id, *title;
+    unsigned int width, height;
+    unsigned char *argb;
+    int hidden, menu_open, pending_action;
+    unsigned int dirty;
+    DBusConnection *connection;
+};
+
+static struct sni_item *items;
+static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t worker;
+static int wake_pipe[2] = {-1, -1}, worker_running, stopping;
+static void *dbus_handle;
+
+enum { DIRTY_ICON = 1, DIRTY_TIP = 2, DIRTY_STATUS = 4, DIRTY_REGISTER = 8 };
+
+static struct sni_item *find_item( uint64_t token )
+{
+    struct sni_item *item;
+    for (item = items; item; item = item->next) if (item->token == token) return item;
+    return NULL;
+}
+
+static int load_dbus(void)
+{
+    if (dbus_handle) return 1;
+    if (!(dbus_handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW ))) return 0;
+#define DO_FUNC(func) if (!(p_##func = dlsym( dbus_handle, #func ))) goto failed;
+    DBUS_FUNCS
+#undef DO_FUNC
+    if (!p_dbus_threads_init_default()) goto failed;
+    return 1;
+failed:
+    dlclose( dbus_handle );
+    dbus_handle = NULL;
+    return 0;
+}
+
+static int append_string( DBusMessageIter *iter, const char *value )
+{
+    return p_dbus_message_iter_append_basic( iter, DBUS_TYPE_STRING, &value );
+}
+
+static int append_pixmaps( DBusMessageIter *iter, const struct sni_item *item, int render )
+{
+    DBusMessageIter array, image, bytes;
+    int width = item->width, height = item->height, size = width * height * 4;
+
+    if (!p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "(iiay)", &array )) return 0;
+    if (render && item->argb && width && height)
+    {
+        if (!p_dbus_message_iter_open_container( &array, DBUS_TYPE_STRUCT, NULL, &image ) ||
+            !p_dbus_message_iter_append_basic( &image, DBUS_TYPE_INT32, &width ) ||
+            !p_dbus_message_iter_append_basic( &image, DBUS_TYPE_INT32, &height ) ||
+            !p_dbus_message_iter_open_container( &image, DBUS_TYPE_ARRAY, "y", &bytes ) ||
+            !p_dbus_message_iter_append_fixed_array( &bytes, DBUS_TYPE_BYTE, &item->argb, size ) ||
+            !p_dbus_message_iter_close_container( &image, &bytes ) ||
+            !p_dbus_message_iter_close_container( &array, &image )) return 0;
+    }
+    return p_dbus_message_iter_close_container( iter, &array );
+}
+
+static const char *property_signature( const char *interface, const char *name )
+{
+    if (!strcmp( interface, SNI_MENU ))
+    {
+        if (!strcmp( name, "Version" )) return "u";
+        if (!strcmp( name, "IconThemePath" )) return "as";
+        if (!strcmp( name, "TextDirection" ) || !strcmp( name, "Status" )) return "s";
+        return NULL;
+    }
+    if (strcmp( interface, SNI_ITEM )) return NULL;
+    if (!strcmp( name, "Menu" )) return "o";
+    if (!strcmp( name, "WindowId" )) return "i";
+    if (!strcmp( name, "ItemIsMenu" )) return "b";
+    if (!strcmp( name, "ToolTip" )) return "(sa(iiay)ss)";
+    if (!strcmp( name, "IconPixmap" ) || !strcmp( name, "OverlayIconPixmap" ) ||
+        !strcmp( name, "AttentionIconPixmap" )) return "a(iiay)";
+    if (!strcmp( name, "Category" ) || !strcmp( name, "Id" ) || !strcmp( name, "Title" ) ||
+        !strcmp( name, "Status" ) || !strcmp( name, "IconName" ) || !strcmp( name, "IconThemePath" ) ||
+        !strcmp( name, "OverlayIconName" ) || !strcmp( name, "AttentionIconName" ) ||
+        !strcmp( name, "AttentionMovieName" )) return "s";
+    return NULL;
+}
+
+static int append_property_value( DBusMessageIter *iter, const struct sni_item *item,
+                                  const char *interface, const char *name )
+{
+    DBusMessageIter array, tooltip;
+    dbus_uint32_t version = 3;
+    dbus_int32_t window = 0;
+    dbus_bool_t is_menu = FALSE;
+    const char *value = "";
+
+    if (!strcmp( interface, SNI_MENU ))
+    {
+        if (!strcmp( name, "Version" ))
+            return p_dbus_message_iter_append_basic( iter, DBUS_TYPE_UINT32, &version );
+        if (!strcmp( name, "IconThemePath" ))
+            return p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "s", &array ) &&
+                   p_dbus_message_iter_close_container( iter, &array );
+        return append_string( iter, !strcmp( name, "Status" ) ? "normal" : "ltr" );
+    }
+    if (!strcmp( name, "Menu" ))
+    {
+        value = MENU_PATH;
+        return p_dbus_message_iter_append_basic( iter, DBUS_TYPE_OBJECT_PATH, &value );
+    }
+    if (!strcmp( name, "WindowId" )) return p_dbus_message_iter_append_basic( iter, DBUS_TYPE_INT32, &window );
+    if (!strcmp( name, "ItemIsMenu" )) return p_dbus_message_iter_append_basic( iter, DBUS_TYPE_BOOLEAN, &is_menu );
+    if (!strcmp( name, "ToolTip" ))
+        return p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &tooltip ) &&
+               append_string( &tooltip, "" ) && append_pixmaps( &tooltip, item, 0 ) &&
+               append_string( &tooltip, item->title ) && append_string( &tooltip, "" ) &&
+               p_dbus_message_iter_close_container( iter, &tooltip );
+    if (strstr( name, "Pixmap" )) return append_pixmaps( iter, item, !strcmp( name, "IconPixmap" ) );
+    if (!strcmp( name, "Category" )) value = "ApplicationStatus";
+    if (!strcmp( name, "Id" )) value = item->id;
+    if (!strcmp( name, "Title" )) value = item->title;
+    if (!strcmp( name, "Status" )) value = item->hidden ? "Passive" : "Active";
+    return append_string( iter, value );
+}
+
+static int append_property( DBusMessageIter *iter, const struct sni_item *item, const char *interface,
+                            const char *name, int dictionary )
+{
+    DBusMessageIter entry, variant;
+    const char *signature = property_signature( interface, name );
+    DBusMessageIter *parent = iter;
+
+    if (!signature) return 0;
+    if (dictionary)
+    {
+        if (!p_dbus_message_iter_open_container( iter, DBUS_TYPE_DICT_ENTRY, NULL, &entry ) ||
+            !append_string( &entry, name )) return 0;
+        parent = &entry;
+    }
+    if (!p_dbus_message_iter_open_container( parent, DBUS_TYPE_VARIANT, signature, &variant ) ||
+        !append_property_value( &variant, item, interface, name ) ||
+        !p_dbus_message_iter_close_container( parent, &variant )) return 0;
+    return !dictionary || p_dbus_message_iter_close_container( iter, &entry );
+}
+
+static int append_menu_property( DBusMessageIter *iter, const char *name, const char *text, int boolean )
+{
+    DBusMessageIter entry, value;
+    dbus_bool_t enabled = TRUE;
+    return p_dbus_message_iter_open_container( iter, DBUS_TYPE_DICT_ENTRY, NULL, &entry ) &&
+           append_string( &entry, name ) &&
+           p_dbus_message_iter_open_container( &entry, DBUS_TYPE_VARIANT, boolean ? "b" : "s", &value ) &&
+           (boolean ? (int)p_dbus_message_iter_append_basic( &value, DBUS_TYPE_BOOLEAN, &enabled ) :
+                      append_string( &value, text )) &&
+           p_dbus_message_iter_close_container( &entry, &value ) &&
+           p_dbus_message_iter_close_container( iter, &entry );
+}
+
+static int append_menu_properties( DBusMessageIter *iter, int id )
+{
+    DBusMessageIter props;
+    if (!p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "{sv}", &props )) return 0;
+    if (!id)
+    {
+        if (!append_menu_property( &props, "children-display", "submenu", 0 )) return 0;
+    }
+    else if (!append_menu_property( &props, "label", id == 1 ? "打开" : "更多操作…", 0 ) ||
+             !append_menu_property( &props, "visible", NULL, 1 ) ||
+             !append_menu_property( &props, "enabled", NULL, 1 )) return 0;
+    return p_dbus_message_iter_close_container( iter, &props );
+}
+
+static int append_menu_layout( DBusMessageIter *iter, int id, int depth )
+{
+    DBusMessageIter layout, children, variant;
+    int child;
+    if (!p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &layout ) ||
+        !p_dbus_message_iter_append_basic( &layout, DBUS_TYPE_INT32, &id ) ||
+        !append_menu_properties( &layout, id ) ||
+        !p_dbus_message_iter_open_container( &layout, DBUS_TYPE_ARRAY, "v", &children )) return 0;
+    if (!id && depth)
+    {
+        for (child = 1; child <= 2; child++)
+            if (!p_dbus_message_iter_open_container( &children, DBUS_TYPE_VARIANT, "(ia{sv}av)", &variant ) ||
+                !append_menu_layout( &variant, child, 0 ) ||
+                !p_dbus_message_iter_close_container( &children, &variant )) return 0;
+    }
+    return p_dbus_message_iter_close_container( &layout, &children ) &&
+           p_dbus_message_iter_close_container( iter, &layout );
+}
+
+static int handle_menu_event( struct sni_item *item, DBusMessageIter *iter )
+{
+    dbus_int32_t id;
+    const char *event;
+    unsigned int action;
+
+    p_dbus_message_iter_get_basic( iter, &id );
+    p_dbus_message_iter_next( iter );
+    p_dbus_message_iter_get_basic( iter, &event );
+    if (!id && !strcmp( event, "opened" ))
+    {
+        item->menu_open = 1;
+        item->pending_action = 0;
+    }
+    if (!id && !strcmp( event, "closed" )) item->menu_open = 0;
+    if ((id == 1 || id == 2) && !strcmp( event, "clicked" )) item->pending_action = id;
+    if (item->menu_open || !item->pending_action || item->hidden) return 1;
+    action = item->pending_action == 1 ? SNI_ACTION_ACTIVATE : SNI_ACTION_CONTEXT_MENU;
+    if (!sni_queue_event( item->token, action, 0, 0 )) return 0;
+    item->pending_action = 0;
+    return 1;
+}
+
+static DBusHandlerResult handle_method( DBusConnection *connection, DBusMessage *message, void *user_data )
+{
+    static const char *item_properties[] = {"Category", "Id", "Title", "Status", "WindowId", "IconName",
+        "IconThemePath", "IconPixmap", "Menu", "ItemIsMenu", "ToolTip", "OverlayIconName", "OverlayIconPixmap",
+        "AttentionIconName", "AttentionIconPixmap", "AttentionMovieName", NULL};
+    static const char *menu_properties[] = {"Version", "TextDirection", "Status", "IconThemePath", NULL};
+    const char *interface = p_dbus_message_get_interface( message ), *member = p_dbus_message_get_member( message );
+    const char *signature = p_dbus_message_get_signature( message ), *property_interface, *name, **property;
+    DBusMessageIter iter, input, array, value, events;
+    struct sni_item *item;
+    DBusMessage *reply = NULL;
+    dbus_uint32_t revision = 1;
+    dbus_int32_t id, depth, x, y;
+    dbus_bool_t need_update = FALSE;
+    unsigned int action;
+    int ok = 1;
+
+    if (!interface || !member || !p_dbus_message_is_method_call( message, interface, member ))
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    if (!(reply = p_dbus_message_new_method_return( message ))) return DBUS_HANDLER_RESULT_NEED_MEMORY;
+    p_dbus_message_iter_init_append( reply, &iter );
+    pthread_mutex_lock( &mutex );
+    if (!(item = find_item( (uintptr_t)user_data )) || item->connection != connection) goto unknown;
+    if (!strcmp( interface, DBUS_INTERFACE_PROPERTIES ))
+    {
+        if (!strcmp( member, "Get" ) && !strcmp( signature, "ss" ))
+        {
+            p_dbus_message_get_args( message, NULL, DBUS_TYPE_STRING, &property_interface,
+                                     DBUS_TYPE_STRING, &name, DBUS_TYPE_INVALID );
+            if (!property_signature( property_interface, name )) goto unknown;
+            ok = append_property( &iter, item, property_interface, name, 0 );
+        }
+        else if (!strcmp( member, "GetAll" ) && !strcmp( signature, "s" ))
+        {
+            p_dbus_message_get_args( message, NULL, DBUS_TYPE_STRING, &property_interface, DBUS_TYPE_INVALID );
+            property = !strcmp( property_interface, SNI_ITEM ) ? item_properties :
+                       !strcmp( property_interface, SNI_MENU ) ? menu_properties : NULL;
+            if (!property) goto unknown;
+            ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &array );
+            while (ok && *property) ok = append_property( &array, item, property_interface, *property++, 1 );
+            if (ok) ok = p_dbus_message_iter_close_container( &iter, &array );
+        }
+        else goto unknown;
+    }
+    else if (!strcmp( interface, SNI_ITEM ))
+    {
+        action = !strcmp( member, "Activate" ) ? SNI_ACTION_ACTIVATE :
+                 !strcmp( member, "ContextMenu" ) ? SNI_ACTION_CONTEXT_MENU :
+                 !strcmp( member, "SecondaryActivate" ) ? SNI_ACTION_SECONDARY : 0;
+        if (action && !strcmp( signature, "ii" ))
+        {
+            p_dbus_message_get_args( message, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID );
+            ok = item->hidden || sni_queue_event( item->token, action, x, y );
+        }
+        else if ((!strcmp( member, "ProvideXdgActivationToken" ) && !strcmp( signature, "s" )) ||
+                 (!strcmp( member, "Scroll" ) && !strcmp( signature, "is" ))) {}
+        else goto unknown;
+    }
+    else if (!strcmp( interface, SNI_MENU ))
+    {
+        p_dbus_message_iter_init( message, &input );
+        if (!strcmp( member, "GetLayout" ) && !strcmp( signature, "iias" ))
+        {
+            p_dbus_message_iter_get_basic( &input, &id );
+            p_dbus_message_iter_next( &input );
+            p_dbus_message_iter_get_basic( &input, &depth );
+            if (id < 0 || id > 2) goto unknown;
+            ok = p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_UINT32, &revision ) &&
+                 append_menu_layout( &iter, id, depth );
+        }
+        else if (!strcmp( member, "GetGroupProperties" ) && !strcmp( signature, "aias" ))
+        {
+            p_dbus_message_iter_recurse( &input, &events );
+            ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "(ia{sv})", &array );
+            while (ok && p_dbus_message_iter_get_arg_type( &events ) == DBUS_TYPE_INT32)
+            {
+                p_dbus_message_iter_get_basic( &events, &id );
+                if (id < 0 || id > 2) goto unknown;
+                ok = p_dbus_message_iter_open_container( &array, DBUS_TYPE_STRUCT, NULL, &value ) &&
+                     p_dbus_message_iter_append_basic( &value, DBUS_TYPE_INT32, &id ) &&
+                     append_menu_properties( &value, id ) && p_dbus_message_iter_close_container( &array, &value );
+                p_dbus_message_iter_next( &events );
+            }
+            if (ok) ok = p_dbus_message_iter_close_container( &iter, &array );
+        }
+        else if (!strcmp( member, "GetProperty" ) && !strcmp( signature, "is" ))
+        {
+            const char *text;
+            dbus_bool_t enabled = TRUE;
+            p_dbus_message_iter_get_basic( &input, &id );
+            p_dbus_message_iter_next( &input );
+            p_dbus_message_iter_get_basic( &input, &name );
+            if (id < 0 || id > 2) goto unknown;
+            if (id && (!strcmp( name, "enabled" ) || !strcmp( name, "visible" )))
+                ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "b", &value ) &&
+                     p_dbus_message_iter_append_basic( &value, DBUS_TYPE_BOOLEAN, &enabled ) &&
+                     p_dbus_message_iter_close_container( &iter, &value );
+            else
+            {
+                if (!id && !strcmp( name, "children-display" )) text = "submenu";
+                else if (id && !strcmp( name, "label" )) text = id == 1 ? "打开" : "更多操作…";
+                else goto unknown;
+                ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "s", &value ) &&
+                     append_string( &value, text ) && p_dbus_message_iter_close_container( &iter, &value );
+            }
+        }
+        else if (!strcmp( member, "Event" ) && !strcmp( signature, "isvu" )) ok = handle_menu_event( item, &input );
+        else if (!strcmp( member, "EventGroup" ) && !strcmp( signature, "a(isvu)" ))
+        {
+            p_dbus_message_iter_recurse( &input, &events );
+            while (ok && p_dbus_message_iter_get_arg_type( &events ) == DBUS_TYPE_STRUCT)
+            {
+                p_dbus_message_iter_recurse( &events, &value );
+                ok = handle_menu_event( item, &value );
+                p_dbus_message_iter_next( &events );
+            }
+            if (ok) ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "i", &array ) &&
+                         p_dbus_message_iter_close_container( &iter, &array );
+        }
+        else if (!strcmp( member, "AboutToShow" ) && !strcmp( signature, "i" ))
+            ok = p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_BOOLEAN, &need_update );
+        else if (!strcmp( member, "AboutToShowGroup" ) && !strcmp( signature, "ai" ))
+        {
+            ok = p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "i", &array ) &&
+                 p_dbus_message_iter_close_container( &iter, &array ) &&
+                 p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "i", &array ) &&
+                 p_dbus_message_iter_close_container( &iter, &array );
+        }
+        else goto unknown;
+    }
+    else goto unknown;
+    pthread_mutex_unlock( &mutex );
+    if (ok) ok = p_dbus_connection_send( connection, reply, NULL );
+    p_dbus_message_unref( reply );
+    return ok ? DBUS_HANDLER_RESULT_HANDLED : DBUS_HANDLER_RESULT_NEED_MEMORY;
+unknown:
+    pthread_mutex_unlock( &mutex );
+    p_dbus_message_unref( reply );
+    if (!(reply = p_dbus_message_new_error( message, DBUS_ERROR_UNKNOWN_METHOD, "Unknown SNI operation" )))
+        return DBUS_HANDLER_RESULT_NEED_MEMORY;
+    ok = p_dbus_connection_send( connection, reply, NULL );
+    p_dbus_message_unref( reply );
+    return ok ? DBUS_HANDLER_RESULT_HANDLED : DBUS_HANDLER_RESULT_NEED_MEMORY;
+}
+
+static void register_item( DBusConnection *connection )
+{
+    const char *path = ITEM_PATH;
+    DBusMessage *message = p_dbus_message_new_method_call( SNI_WATCHER, "/StatusNotifierWatcher", SNI_WATCHER,
+                                                         "RegisterStatusNotifierItem" );
+    if (!message) return;
+    p_dbus_message_set_no_reply( message, TRUE );
+    if (p_dbus_message_append_args( message, DBUS_TYPE_STRING, &path, DBUS_TYPE_INVALID ))
+        p_dbus_connection_send( connection, message, NULL );
+    p_dbus_message_unref( message );
+}
+
+static DBusHandlerResult watcher_changed( DBusConnection *connection, DBusMessage *message, void *data )
+{
+    const char *name, *old_owner, *new_owner;
+    if (p_dbus_message_is_signal( message, DBUS_INTERFACE_DBUS, "NameOwnerChanged" ) &&
+        p_dbus_message_get_args( message, NULL, DBUS_TYPE_STRING, &name, DBUS_TYPE_STRING, &old_owner,
+                                 DBUS_TYPE_STRING, &new_owner, DBUS_TYPE_INVALID ) &&
+        !strcmp( name, SNI_WATCHER ) && *new_owner) register_item( connection );
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static void send_signal( DBusConnection *connection, const char *name, const char *status )
+{
+    DBusMessage *message = p_dbus_message_new_signal( ITEM_PATH, SNI_ITEM, name );
+    if (!message) return;
+    if (!status || p_dbus_message_append_args( message, DBUS_TYPE_STRING, &status, DBUS_TYPE_INVALID ))
+        p_dbus_connection_send( connection, message, NULL );
+    p_dbus_message_unref( message );
+}
+
+static void wake_worker(void)
+{
+    unsigned char byte = 0;
+    ssize_t ret;
+    if (wake_pipe[1] >= 0)
+        do ret = write( wake_pipe[1], &byte, 1 ); while (ret < 0 && errno == EINTR);
+}
+
+static void *run_worker( void *arg )
+{
+    for (;;)
+    {
+        struct sni_item *item;
+        DBusConnection **connections;
+        struct pollfd *fds;
+        unsigned char bytes[128];
+        unsigned int count = 0, index = 0;
+
+        pthread_mutex_lock( &mutex );
+        if (stopping)
+        {
+            pthread_mutex_unlock( &mutex );
+            return NULL;
+        }
+        for (item = items; item; item = item->next) count++;
+        connections = calloc( count, sizeof(*connections) );
+        fds = calloc( count + 1, sizeof(*fds) );
+        if (!fds || (count && !connections))
+        {
+            struct pollfd wake = {.fd = wake_pipe[0], .events = POLLIN};
+            pthread_mutex_unlock( &mutex );
+            free( connections );
+            free( fds );
+            poll( &wake, 1, 100 );
+            continue;
+        }
+        fds[0].fd = wake_pipe[0];
+        fds[0].events = POLLIN;
+        for (item = items; item; item = item->next)
+        {
+            DBusConnection *connection = item->connection;
+            connections[index] = p_dbus_connection_ref( connection );
+            fds[index + 1].fd = -1;
+            p_dbus_connection_get_unix_fd( connection, &fds[index + 1].fd );
+            fds[index + 1].events = POLLIN;
+            if (item->dirty & DIRTY_REGISTER) register_item( connection );
+            if (item->dirty & DIRTY_ICON) send_signal( connection, "NewIcon", NULL );
+            if (item->dirty & DIRTY_TIP)
+            {
+                send_signal( connection, "NewToolTip", NULL );
+                send_signal( connection, "NewTitle", NULL );
+            }
+            if (item->dirty & DIRTY_STATUS)
+                send_signal( connection, "NewStatus", item->hidden ? "Passive" : "Active" );
+            item->dirty = 0;
+            index++;
+        }
+        pthread_mutex_unlock( &mutex );
+        for (index = 0; index < count; index++)
+        {
+            if (p_dbus_connection_read_write( connections[index], 0 ))
+            {
+                while (p_dbus_connection_dispatch( connections[index] ) == DBUS_DISPATCH_DATA_REMAINS) {}
+                if (p_dbus_connection_get_outgoing_size( connections[index] )) fds[index + 1].events |= POLLOUT;
+            }
+            else fds[index + 1].fd = -1;
+        }
+        poll( fds, count + 1, -1 );
+        if (fds[0].revents) while (read( wake_pipe[0], bytes, sizeof(bytes) ) > 0) {}
+        for (index = 0; index < count; index++) p_dbus_connection_unref( connections[index] );
+        free( connections );
+        free( fds );
+    }
+}
+
+static unsigned char *copy_pixels( unsigned int width, unsigned int height, const unsigned char *argb )
+{
+    unsigned char *copy;
+    size_t size;
+    if (!argb || !width || !height) return NULL;
+    if (width > 1024 || height > 1024) return NULL;
+    size = width * height * 4;
+    if (!(copy = malloc( size ))) return NULL;
+    memcpy( copy, argb, size );
+    return copy;
+}
+
+static void free_item( struct sni_item *item )
+{
+    if (item->connection)
+    {
+        p_dbus_connection_close( item->connection );
+        p_dbus_connection_unref( item->connection );
+    }
+    free( item->argb );
+    free( item->title );
+    free( item->id );
+    free( item );
+}
+
+int sni_dbus_add( uint64_t token, const char *id, const char *title, unsigned int width,
+                  unsigned int height, const unsigned char *argb, int hidden )
+{
+    static const DBusObjectPathVTable vtable = {.message_function = handle_method};
+    static const char match[] = "type='signal',sender='org.freedesktop.DBus',"
+        "interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='org.kde.StatusNotifierWatcher'";
+    struct sni_item *item;
+    DBusError error;
+    int ok;
+
+    if (!load_dbus()) return 0;
+    if (!(item = calloc( 1, sizeof(*item) ))) return 0;
+    item->token = token;
+    item->width = width;
+    item->height = height;
+    item->hidden = hidden;
+    item->dirty = DIRTY_REGISTER;
+    if (!(item->id = strdup( id )) || !(item->title = strdup( title ? title : "Wine application" ))) goto failed;
+    item->argb = copy_pixels( width, height, argb );
+    if (argb && width && height && !item->argb) goto failed;
+    p_dbus_error_init( &error );
+    if (!(item->connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error ))) goto dbus_failed;
+    p_dbus_connection_set_exit_on_disconnect( item->connection, FALSE );
+    if (!p_dbus_bus_name_has_owner( item->connection, SNI_WATCHER, &error )) goto dbus_failed;
+    if (!p_dbus_connection_register_object_path( item->connection, ITEM_PATH, &vtable, (void *)(uintptr_t)token ) ||
+        !p_dbus_connection_register_object_path( item->connection, MENU_PATH, &vtable, (void *)(uintptr_t)token ) ||
+        !p_dbus_connection_add_filter( item->connection, watcher_changed, NULL, NULL )) goto dbus_failed;
+    p_dbus_bus_add_match( item->connection, match, &error );
+    if (p_dbus_error_is_set( &error )) goto dbus_failed;
+    pthread_mutex_lock( &mutex );
+    if (find_item( token ) || stopping)
+    {
+        pthread_mutex_unlock( &mutex );
+        goto failed;
+    }
+    if (!worker_running)
+    {
+        if (pipe2( wake_pipe, O_NONBLOCK | O_CLOEXEC ))
+        {
+            pthread_mutex_unlock( &mutex );
+            goto failed;
+        }
+        if (!(ok = !pthread_create( &worker, NULL, run_worker, NULL )))
+        {
+            close( wake_pipe[0] );
+            close( wake_pipe[1] );
+            wake_pipe[0] = wake_pipe[1] = -1;
+            pthread_mutex_unlock( &mutex );
+            goto failed;
+        }
+        worker_running = 1;
+    }
+    item->next = items;
+    items = item;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    return 1;
+dbus_failed:
+    if (p_dbus_error_is_set( &error )) p_dbus_error_free( &error );
+failed:
+    free_item( item );
+    return 0;
+}
+
+int sni_dbus_update( uint64_t token, const char *title, unsigned int width, unsigned int height,
+                     const unsigned char *argb, int hidden )
+{
+    struct sni_item *item;
+    unsigned char *pixels = copy_pixels( width, height, argb );
+    char *text = title ? strdup( title ) : NULL;
+
+    if ((title && !text) || (argb && width && height && !pixels)) goto failed;
+    pthread_mutex_lock( &mutex );
+    if (!(item = find_item( token )))
+    {
+        pthread_mutex_unlock( &mutex );
+        goto failed;
+    }
+    if (title)
+    {
+        free( item->title );
+        item->title = text;
+        item->dirty |= DIRTY_TIP;
+    }
+    if (argb)
+    {
+        free( item->argb );
+        item->argb = pixels;
+        item->width = width;
+        item->height = height;
+        item->dirty |= DIRTY_ICON;
+    }
+    if (item->hidden != hidden)
+    {
+        item->hidden = hidden;
+        item->pending_action = 0;
+        item->menu_open = 0;
+        item->dirty |= DIRTY_STATUS;
+    }
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    return 1;
+failed:
+    free( text );
+    free( pixels );
+    return 0;
+}
+
+void sni_dbus_remove( uint64_t token )
+{
+    struct sni_item **link, *item;
+    pthread_mutex_lock( &mutex );
+    for (link = &items; *link; link = &(*link)->next) if ((*link)->token == token) break;
+    item = *link;
+    if (item) *link = item->next;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    if (item) free_item( item );
+}
+
+void sni_dbus_cleanup(void)
+{
+    struct sni_item *item, *next;
+    int join;
+    pthread_mutex_lock( &mutex );
+    stopping = 1;
+    join = worker_running;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    if (join) pthread_join( worker, NULL );
+    pthread_mutex_lock( &mutex );
+    for (item = items; item; item = next)
+    {
+        next = item->next;
+        free_item( item );
+    }
+    items = NULL;
+    if (wake_pipe[0] >= 0) close( wake_pipe[0] );
+    if (wake_pipe[1] >= 0) close( wake_pipe[1] );
+    wake_pipe[0] = wake_pipe[1] = -1;
+    worker_running = stopping = 0;
+    pthread_mutex_unlock( &mutex );
+}
+
+
+#else
+int sni_dbus_add( uint64_t token, const char *id, const char *title, unsigned int width,
+                  unsigned int height, const unsigned char *argb, int hidden ) { return 0; }
+int sni_dbus_update( uint64_t token, const char *title, unsigned int width, unsigned int height,
+                     const unsigned char *argb, int hidden ) { return 0; }
+void sni_dbus_remove( uint64_t token ) {}
+void sni_dbus_cleanup(void) {}
+
+#endif
