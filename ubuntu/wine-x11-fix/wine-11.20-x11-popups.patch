+static struct tray_icon *get_icon_token( uint64_t token )
+{
+    struct tray_icon *icon;
+
+    LIST_FOR_EACH_ENTRY( icon, &icon_list, struct tray_icon, entry )
+        if (icon->token == token) return icon;
+    return NULL;
+}
+
+static void delete_icon( struct tray_icon *icon )
+{
+    list_remove( &icon->entry );
+    sni_dbus_remove( icon->token );
+    free( icon );
+}
+
+/* DrawIconEx retains the separate alpha bitmap and also handles monochrome icons. */
+static unsigned char *get_icon_pixels( HICON icon, unsigned int *width, unsigned int *height )
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[2])] = {0};
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    HBITMAP color = 0, mask = 0, previous = 0;
+    unsigned long *bits = NULL;
+    unsigned char *argb = NULL;
+    unsigned int size, i, alpha;
+    LONG cx, cy;
+    HDC hdc = 0;
+    void *color_bits, *mask_bits;
+
+    if (!NtUserGetIconSize( icon, 0, &cx, &cy )) return NULL;
+    cy /= 2;  /* NtUserGetIconSize includes both AND and XOR mask heights. */
+    if (cx <= 0 || cy <= 0 || cx > INT_MAX / cy / 4) return NULL;
+    if (!(hdc = NtGdiCreateCompatibleDC(0))) return NULL;
+    info->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info->bmiHeader.biWidth = cx;
+    info->bmiHeader.biHeight = -cy;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    info->bmiHeader.biSizeImage = cx * cy * 4;
+    color = NtGdiCreateDIBSection( hdc, NULL, 0, info, DIB_RGB_COLORS, 0, 0, 0, &color_bits );
+    if (!color) goto done;
+    memset( color_bits, 0, info->bmiHeader.biSizeImage );
+    if (!(previous = NtGdiSelectBitmap( hdc, color ))) goto done;
+    if (!NtUserDrawIconEx( hdc, 0, 0, icon, cx, cy, 0, 0, DI_NORMAL | DI_NOMIRROR )) goto done;
+
+    info->bmiHeader.biBitCount = 1;
+    info->bmiHeader.biSizeImage = ((cx + 31) / 32 * 4) * cy;
+    info->bmiColors[1].rgbRed = info->bmiColors[1].rgbGreen = info->bmiColors[1].rgbBlue = 255;
+    mask = NtGdiCreateDIBSection( hdc, NULL, 0, info, DIB_RGB_COLORS, 0, 0, 0, &mask_bits );
+    if (!mask) goto done;
+    memset( mask_bits, 255, info->bmiHeader.biSizeImage );
+    NtGdiSelectBitmap( hdc, mask );
+    if (!NtUserDrawIconEx( hdc, 0, 0, icon, cx, cy, 0, 0, DI_MASK | DI_NOMIRROR )) goto done;
+    NtGdiSelectBitmap( hdc, previous );
+    if (!(bits = get_bitmap_argb( hdc, color, mask, &size ))) goto done;
+    if (!(argb = malloc( cx * cy * 4 ))) goto done;
+    for (i = 0; i < cx * cy; i++)
+    {
+        alpha = bits[i + 2] >> 24;
+        argb[i * 4] = alpha;
+        /* DrawIconEx produces premultiplied pixels; SNI uses straight ARGB bytes. */
+        argb[i * 4 + 1] = alpha ? min( 255, (((bits[i + 2] >> 16) & 255) * 255 + alpha / 2) / alpha ) : 0;
+        argb[i * 4 + 2] = alpha ? min( 255, (((bits[i + 2] >> 8) & 255) * 255 + alpha / 2) / alpha ) : 0;
+        argb[i * 4 + 3] = alpha ? min( 255, ((bits[i + 2] & 255) * 255 + alpha / 2) / alpha ) : 0;
+    }
+    *width = cx;
+    *height = cy;
+done:
+    free( bits );
+    if (previous) NtGdiSelectBitmap( hdc, previous );
+    if (hdc) NtGdiDeleteObjectApp( hdc );
+    if (color) NtGdiDeleteObjectApp( color );
+    if (mask) NtGdiDeleteObjectApp( mask );
+    return argb;
+}
+
+static void get_tip_text( const WCHAR *tip, char *text, unsigned int size )
+{
+    DWORD len = 0;
+
+    RtlUnicodeToUTF8N( text, size - 1, &len, tip, lstrlenW(tip) * sizeof(WCHAR) );
+    text[len] = 0;
+}
+
+static BOOL modify_icon( struct tray_icon *icon, const NOTIFYICONDATAW *data )
+{
+    unsigned char blank[4] = {0}, *pixels = NULL;
+    unsigned int width = 0, height = 0;
+    DWORD state = icon->state;
+    char title[384];
+    BOOL ret = TRUE;
+
+    if (data->uFlags & NIF_STATE) state = (state & ~data->dwStateMask) | (data->dwState & data->dwStateMask);
+    if (data->uFlags & NIF_TIP) get_tip_text( data->szTip, title, sizeof(title) );
+    if ((data->uFlags & NIF_ICON) && data->hIcon &&
+        !(pixels = get_icon_pixels( data->hIcon, &width, &height ))) return FALSE;
+    if (data->uFlags & (NIF_ICON | NIF_TIP | NIF_STATE))
+        ret = sni_dbus_update( icon->token, data->uFlags & NIF_TIP ? title : NULL, width, height,
+                              pixels ? pixels : data->uFlags & NIF_ICON ? blank : NULL,
+                              !!(state & NIS_HIDDEN) );
+    free( pixels );
+    if (!ret) return FALSE;
+    icon->state = state;
+    if (data->uFlags & NIF_MESSAGE) icon->callback_message = data->uCallbackMessage;
+    return TRUE;
+}
+
+static LRESULT add_icon( const NOTIFYICONDATAW *data )
+{
+    unsigned char blank[4] = {0}, *pixels = NULL;
+    unsigned int width = 0, height = 0;
+    struct tray_icon *icon;
+    char id[64], title[384] = "Wine";
+    const char *backend = getenv( "WINE_X11_TRAY_BACKEND" );
+
+    if (get_icon( data->hWnd, data->uID )) return FALSE;
+    if (backend && !strcmp( backend, "xembed" )) return -1;
+    if (!sni_events_init()) return -1;
+    tray_display = x11drv_thread_data()->display;
+    if (!(icon = calloc( 1, sizeof(*icon) ))) return FALSE;
+    if ((data->uFlags & NIF_ICON) && data->hIcon &&
+        !(pixels = get_icon_pixels( data->hIcon, &width, &height )))
+    {
+        free( icon );
+        return FALSE;
+    }
+    if (data->uFlags & NIF_TIP) get_tip_text( data->szTip, title, sizeof(title) );
+    icon->owner = data->hWnd;
+    icon->id = data->uID;
+    icon->token = ++next_token;
+    if (!icon->token) icon->token = ++next_token;
+    if (data->uFlags & NIF_MESSAGE) icon->callback_message = data->uCallbackMessage;
+    if (data->uFlags & NIF_STATE) icon->state = data->dwState & data->dwStateMask;
+    snprintf( id, sizeof(id), "wine-%08x-%u", HandleToUlong(icon->owner), icon->id );
+    if (!sni_dbus_add( icon->token, id, title, width, height, pixels ? pixels : blank,
+                       !!(icon->state & NIS_HIDDEN) ))
+    {
+        free( pixels );
+        free( icon );
+        return -1;
+    }
+    free( pixels );
+    list_add_tail( &icon_list, &icon->entry );
+    return TRUE;
+}
+
+LRESULT X11DRV_NotifyIcon( HWND hwnd, UINT msg, NOTIFYICONDATAW *data )
+{
+    struct tray_icon *icon;
+
+    if (msg == NIM_ADD) return add_icon( data );
+    if (!(icon = get_icon( data->hWnd, data->uID ))) return -1;
+    switch (msg)
+    {
+    case NIM_MODIFY:
+        return modify_icon( icon, data );
+    case NIM_DELETE:
+        delete_icon( icon );
+        return TRUE;
+    case NIM_SETVERSION:
+        icon->version = data->uVersion;
+        return TRUE;
+    default:
+        return -1;
+    }
+}
+
+void X11DRV_CleanupIcons( HWND owner )
+{
+    struct tray_icon *icon, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( icon, next, &icon_list, struct tray_icon, entry )
+        if (icon->owner == owner) delete_icon( icon );
+}
+
+/* Re-resolve after each callback because same-process callbacks may delete or replace an item. */
+static BOOL notify_owner( uint64_t token, UINT msg, POINT point )
+{
+    struct tray_icon *icon = get_icon_token( token );
+    struct wine_notify_icon_params params;
+    WPARAM wp;
+    LPARAM lp;
+
+    if (!icon) return FALSE;
+    wp = icon->id;
+    lp = msg;
+    if (icon->version >= NOTIFYICON_VERSION_4)
+    {
+        wp = MAKEWPARAM( point.x, point.y );
+        lp = MAKELPARAM( msg, icon->id );
+    }
+    params.callback_message = icon->callback_message;
+    params.wparam = wp;
+    params.lparam = lp;
+    params.point = point;
+    if (!send_notify_message( icon->owner, WM_WINE_NOTIFYICON, 0, (LPARAM)&params ) &&
+        RtlGetLastWin32Error() == ERROR_INVALID_WINDOW_HANDLE)
+    {
+        if ((icon = get_icon_token( token ))) delete_icon( icon );
+        return FALSE;
+    }
+    return get_icon_token( token ) != NULL;
+}
+
+static POINT get_menu_anchor( HWND root )
+{
+    MONITORINFO monitor = {.cbSize = sizeof(monitor)};
+    RECT rect, visible;
+    POINT point;
+
+    if (!NtUserGetMonitorInfo( NtUserMonitorFromWindow( root, MONITOR_DEFAULTTONEAREST ), &monitor ))
+        monitor.rcWork = NtUserGetVirtualScreenRect( MDT_RAW_DPI );
+    point.x = monitor.rcWork.left + (monitor.rcWork.right - monitor.rcWork.left) / 2;
+    point.y = min( monitor.rcWork.bottom - 1, monitor.rcWork.top + 24 );
+    if (root && NtUserIsWindowVisible(root) && !(NtUserGetWindowLongW( root, GWL_STYLE ) & WS_MINIMIZE) &&
+        NtUserGetWindowRect( root, &rect, 0 ) && intersect_rect( &visible, &rect, &monitor.rcWork ))
+    {
+        point.x = visible.left + (visible.right - visible.left) / 2;
+        point.y = visible.top + (visible.bottom - visible.top) / 2;
+    }
+    return point;
+}
+
+void sni_dispatch_event( uint64_t token, unsigned int action, int x, int y )
+{
+    struct tray_icon *icon = get_icon_token( token );
+    UINT context, version, down, up;
+    HWND root;
+    POINT point;
+
+    if (!icon || (icon->state & NIS_HIDDEN)) return;
+    if (!NtUserIsWindow( icon->owner ))
+    {
+        delete_icon( icon );
+        return;
+    }
+    version = icon->version;
+    context = NtUserSetThreadDpiAwarenessContext( NTUSER_DPI_PER_MONITOR_AWARE );
+    root = NtUserGetAncestor( icon->owner, GA_ROOTOWNER );
+    point = get_menu_anchor( root );
+    /* These actions follow a real shell activation. AllowSetForegroundWindow is still a Wine stub. */
+    if (root && root != NtUserGetDesktopWindow() && !NtUserSetForegroundWindowInternal(root))
+        WARN( "could not activate tray owner root %p\n", root );
+    if (action == SNI_ACTION_CONTEXT_MENU) down = WM_RBUTTONDOWN;
+    else if (action == SNI_ACTION_SECONDARY) down = WM_MBUTTONDOWN;
+    else down = WM_LBUTTONDOWN;
+    up = down + WM_LBUTTONUP - WM_LBUTTONDOWN;
+    if (notify_owner( token, down, point ) && notify_owner( token, up, point ) && version)
+    {
+        if (action == SNI_ACTION_ACTIVATE) notify_owner( token, NIN_SELECT, point );
+        else if (action == SNI_ACTION_CONTEXT_MENU) notify_owner( token, WM_CONTEXTMENU, point );
+    }
+    NtUserSetThreadDpiAwarenessContext( context );
+}
+
+void X11DRV_SNI_ThreadDetach(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct tray_icon *icon, *next;
+
+    if (!data || data->display != tray_display) return;
+    sni_dbus_cleanup();
+    LIST_FOR_EACH_ENTRY_SAFE( icon, next, &icon_list, struct tray_icon, entry )
+    {
+        list_remove( &icon->entry );
+        free( icon );
+    }
+    sni_events_cleanup();
+    tray_display = NULL;
+}
