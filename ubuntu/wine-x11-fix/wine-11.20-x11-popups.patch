+/* Older PnP implementations persisted a full sibling list on every device instance. */
+static void remove_device_siblings_cache( HKEY key, unsigned int depth )
+{
+    WCHAR name[MAX_PATH];
+    DWORD index;
+    HKEY child;
+    LSTATUS status;
+
+    if (!depth)
+    {
+        status = RegDeleteTreeW( key, L"Properties\\{4340A6C5-93FA-4706-972C-7B648008A5A7}\\000A" );
+        if (status && status != ERROR_FILE_NOT_FOUND && status != ERROR_PATH_NOT_FOUND)
+            WARN( "Failed to remove cached device siblings, error %ld.\n", status );
+        return;
+    }
+
+    for (index = 0; !(status = RegEnumKeyW( key, index, name, ARRAY_SIZE(name) )); ++index)
+    {
+        if (!(status = RegOpenKeyExW( key, name, 0, KEY_ALL_ACCESS, &child )))
+        {
+            remove_device_siblings_cache( child, depth - 1 );
+            RegCloseKey( child );
+        }
+        else WARN( "Failed to open device registry key, error %ld.\n", status );
+    }
+    if (status != ERROR_NO_MORE_ITEMS)
+        WARN( "Failed to enumerate device registry keys, error %ld.\n", status );
+}
