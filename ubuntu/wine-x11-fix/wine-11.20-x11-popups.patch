+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+#include <dlfcn.h>
+#include "x11drv.h"
+#ifdef SONAME_LIBXDAMAGE
+#include <X11/extensions/Xdamage.h>
+#endif
+#ifdef SONAME_LIBXDAMAGE
+static typeof(XDamageQueryExtension) *pXDamageQueryExtension;
+static typeof(XDamageCreate) *pXDamageCreate;
+static typeof(XDamageDestroy) *pXDamageDestroy;
+static typeof(XDamageSubtract) *pXDamageSubtract;
+static BOOL damage_available;
+
+static BOOL frame_damage_notify( HWND hwnd, XEvent *event )
+{
+    XDamageNotifyEvent *damage = (XDamageNotifyEvent *)event;
+    struct x11drv_win_data *data;
+
+    if (!(data = get_win_data( hwnd ))) return FALSE;
+    if (data->frame_damage == damage->damage)
+    {
+        /* Clear before composing so drawing arriving during composition is not lost. */
+        pXDamageSubtract( data->display, data->frame_damage, None, None );
+        XFlush( data->display );
+        composite_owned_frame( hwnd, FALSE );
+    }
+    release_win_data( data );
+    return TRUE;
+}
+#endif
+
+void init_frame_damage(void)
+{
+#ifdef SONAME_LIBXDAMAGE
+    int event_base, error_base;
+    void *module = dlopen( SONAME_LIBXDAMAGE, RTLD_NOW );
+
+    if (!module) return;
+#define LOAD_FUNC(f) if (!(p##f = dlsym( module, #f ))) goto failed
+    LOAD_FUNC(XDamageQueryExtension);
+    LOAD_FUNC(XDamageCreate);
+    LOAD_FUNC(XDamageDestroy);
+    LOAD_FUNC(XDamageSubtract);
+#undef LOAD_FUNC
+    if (!pXDamageQueryExtension( gdi_display, &event_base, &error_base )) goto failed;
+    X11DRV_register_event_handler( event_base + XDamageNotify, frame_damage_notify, "DamageNotify" );
+    damage_available = TRUE;
+    return;
+failed:
+    dlclose( module );
+#endif
+}
+
+BOOL frame_damage_supported(void)
+{
+#ifdef SONAME_LIBXDAMAGE
+    return damage_available;
+#else
+    return FALSE;
+#endif
+}
+
+void sync_frame_damage( struct x11drv_win_data *data )
+{
+#ifdef SONAME_LIBXDAMAGE
+    if (!damage_available) return;
+    if (data->whole_window && (data->frame_window || data->frame_owner))
+    {
+        if (!data->frame_damage)
+            data->frame_damage = pXDamageCreate( data->display, data->whole_window, XDamageReportNonEmpty );
+    }
+    else destroy_frame_damage( data );
+#endif
+}
+
+void destroy_frame_damage( struct x11drv_win_data *data )
+{
+#ifdef SONAME_LIBXDAMAGE
+    if (data->frame_damage) pXDamageDestroy( data->display, data->frame_damage );
+    data->frame_damage = 0;
+#endif
+}
