+BOOL X11DRV_CanCompositeFrame(void)
+{
+    return usexcomposite && frame_damage_supported() && pict_formats[WXR_FORMAT_A8R8G8B8];
+}
+
+struct frame_compositor
+{
+    Pixmap buffer;
+    Picture picture;
+    GC gc;
+    int width, height;
+};
+
+void X11DRV_DestroyFrameCompositor( struct frame_compositor **compositor )
+{
+    struct frame_compositor *frame = *compositor;
+
+    if (!frame) return;
+    pthread_mutex_lock( &xrender_mutex );
+    pXRenderFreePicture( gdi_display, frame->picture );
+    XFreePixmap( gdi_display, frame->buffer );
+    XFreeGC( gdi_display, frame->gc );
+    pthread_mutex_unlock( &xrender_mutex );
+    free( frame );
+    *compositor = NULL;
+}
+
+void X11DRV_CompositeFrame( Window window, struct frame_compositor **compositor )
+{
+#ifdef SONAME_LIBXCOMPOSITE
+    XWindowAttributes frame, attr;
+    struct frame_compositor *state = *compositor;
+    Window root, parent, *children;
+    Pixmap source;
+    Picture dest, pict, mask;
+    XRenderColor clear = {0};
+    XGCValues values = {.subwindow_mode = IncludeInferiors, .graphics_exposures = False};
+    unsigned int count, i;
+    unsigned long length, remaining;
+    unsigned char *opacity;
+    Atom type;
+    int format, alpha;
+
+    if (!XGetWindowAttributes( gdi_display, window, &frame ) || frame.map_state != IsViewable ||
+        !XQueryTree( gdi_display, window, &root, &parent, &children, &count )) return;
+    if (state && (state->width != frame.width || state->height != frame.height))
+    {
+        X11DRV_DestroyFrameCompositor( compositor );
+        state = NULL;
+    }
+    pthread_mutex_lock( &xrender_mutex );
+    if (!state)
+    {
+        if (!(state = calloc( 1, sizeof(*state) ))) goto done;
+        state->width = frame.width;
+        state->height = frame.height;
+        state->buffer = XCreatePixmap( gdi_display, window, frame.width, frame.height, frame.depth );
+        state->picture = pXRenderCreatePicture( gdi_display, state->buffer,
+                                               pXRenderFindVisualFormat( gdi_display, frame.visual ), 0, NULL );
+        state->gc = XCreateGC( gdi_display, window, GCSubwindowMode | GCGraphicsExposures, &values );
+        *compositor = state;
+    }
+    dest = state->picture;
+    pXRenderFillRectangle( gdi_display, PictOpSrc, dest, &clear, 0, 0, frame.width, frame.height );
+    /* XQueryTree returns bottom-to-top order. Compose alpha before publishing the group. */
+    for (i = 0; i < count; i++)
+    {
+        if (!XGetWindowAttributes( gdi_display, children[i], &attr ) || attr.map_state != IsViewable) continue;
+        source = pXCompositeNameWindowPixmap( gdi_display, children[i] );
+        pict = pXRenderCreatePicture( gdi_display, source,
+                                     pXRenderFindVisualFormat( gdi_display, attr.visual ), 0, NULL );
+#ifdef HAVE_LIBXSHAPE
+        {
+            int rect_count, order;
+            XRectangle *rects = XShapeGetRectangles( gdi_display, children[i], ShapeBounding, &rect_count, &order );
+            pXRenderSetPictureClipRectangles( gdi_display, pict, 0, 0, rects, rect_count );
+            if (rects) XFree( rects );
+        }
+#endif
+        alpha = 0xffff;
+        if (!XGetWindowProperty( gdi_display, children[i], x11drv_atom(_NET_WM_WINDOW_OPACITY), 0, 1,
+                                 False, XA_CARDINAL, &type, &format, &length, &remaining, &opacity ))
+        {
+            if (type == XA_CARDINAL && format == 32 && length) alpha = *(unsigned long *)opacity >> 16;
+            if (opacity) XFree( opacity );
+        }
+        mask = get_mask_pict( alpha );
+        pXRenderComposite( gdi_display, PictOpOver, pict, mask, dest, 0, 0, 0, 0,
+                           attr.x, attr.y, attr.width, attr.height );
+        pXRenderFreePicture( gdi_display, pict );
+        XFreePixmap( gdi_display, source );
+    }
+    XCopyArea( gdi_display, state->buffer, window, state->gc, 0, 0, frame.width, frame.height, 0, 0 );
+done:
+    XFree( children );
+    XFlush( gdi_display );
+    pthread_mutex_unlock( &xrender_mutex );
+#endif
+}
