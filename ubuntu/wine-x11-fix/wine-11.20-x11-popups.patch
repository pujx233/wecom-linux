+static void cancel_first_present( struct x11drv_win_data *data, BOOL restore )
+{
+    struct window_surface *surface = data->first_present_surface;
+    COLORREF key;
+    DWORD flags = 0;
+    BYTE alpha = 255;
+
+    data->first_present_surface = NULL;
+    data->first_present_replacement = FALSE;
+    data->first_present_serial = 0;
+    data->first_present_ready = data->first_present_uploaded = data->first_present_fallback = FALSE;
+    if (!surface) return;
+    if (restore && data->whole_window && !data->first_present_argb)
+    {
+        NtUserGetLayeredWindowAttributes( data->hwnd, &key, &alpha, &flags );
+        sync_window_opacity( data->display, get_wm_window( data ), alpha, flags );
+    }
+    data->first_present_argb = FALSE;
+    if (surface) window_surface_release( surface );
+}
+
+static void queue_first_present( struct x11drv_win_data *data )
+{
+    if (data->first_present_surface && (data->first_present_uploaded || data->first_present_fallback))
+        NtUserPostMessage( data->hwnd, WM_X11DRV_FIRST_PRESENT, data->first_present_serial,
+                           data->first_present_fallback );
+}
+
+void set_first_present_surface( struct x11drv_win_data *data, struct window_surface *surface, BOOL replacement )
+{
+    if (data->first_present_surface != surface)
+    {
+        window_surface_add_ref( surface );
+        if (data->first_present_surface) window_surface_release( data->first_present_surface );
+        data->first_present_surface = surface;
+    }
+    do data->first_present_serial = InterlockedIncrement( &first_present_serial );
+    while (!data->first_present_serial);
+    data->first_present_replacement = replacement;
+    data->first_present_ready = data->first_present_uploaded = data->first_present_fallback = FALSE;
+}
+
+/* An unmapped window clips image uploads. Keep the bounds dirty until the native map is complete. */
+BOOL window_surface_can_present( HWND hwnd, Window window, struct window_surface *surface )
+{
+    struct x11drv_win_data *data;
+    XWindowAttributes attr;
+    BOOL pending = FALSE, mapped, hold = FALSE;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        pending = data->whole_window == window && data->first_present_surface == surface;
+        hold = pending && (data->first_present_argb || data->first_present_replacement) &&
+               !data->first_present_ready;
+        release_win_data( data );
+    }
+    if (hold)
+    {
+        TRACE( "first-present defer pending surface hwnd %p/%lx\n", hwnd, window );
+        return FALSE;
+    }
+    if (!pending) return TRUE;
+    X11DRV_expect_error( gdi_display, host_window_error, NULL );
+    mapped = XGetWindowAttributes( gdi_display, window, &attr ) && attr.map_state == IsViewable;
+    if (X11DRV_check_error()) mapped = FALSE;
+    if (!mapped) TRACE( "first-present defer unmapped hwnd %p/%lx\n", hwnd, window );
+    return mapped;
+}
+
+/* The upload and opacity property use different X connections. Complete the upload first. */
+void window_surface_presented( HWND hwnd, Window window, struct window_surface *surface )
+{
+    struct x11drv_win_data *data;
+    ULONG serial = 0;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        if (data->whole_window == window && data->first_present_surface == surface && data->first_present_ready)
+            serial = data->first_present_serial;
+        release_win_data( data );
+    }
+    if (!serial) return;
+    XSync( gdi_display, False );
+    if (!(data = get_win_data( hwnd ))) return;
+    if (data->whole_window != window || data->first_present_surface != surface ||
+        data->first_present_serial != serial || !data->first_present_ready) serial = 0;
+    else data->first_present_uploaded = TRUE;
+    release_win_data( data );
+    if (serial) NtUserPostMessage( hwnd, WM_X11DRV_FIRST_PRESENT, serial, 0 );
+}
