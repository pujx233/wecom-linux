+/* The upload and opacity property use different X connections. Complete the upload first. */
+void window_surface_presented( HWND hwnd, Window window, struct window_surface *surface )
+{
+    struct x11drv_win_data *data;
+    ULONG serial = 0;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        if (data->whole_window == window && data->first_present_surface == surface && data->first_present_ready)
+            serial = data->first_present_serial;
+        release_win_data( data );
+    }
+    if (!serial) return;
+    XSync( gdi_display, False );
+    if (!(data = get_win_data( hwnd ))) return;
+    if (data->whole_window != window || data->first_present_surface != surface ||
+        data->first_present_serial != serial || !data->first_present_ready) serial = 0;
+    else data->first_present_uploaded = TRUE;
+    release_win_data( data );
+    if (serial) send_notify_message( hwnd, WM_X11DRV_FIRST_PRESENT, serial, 0 );
+}
