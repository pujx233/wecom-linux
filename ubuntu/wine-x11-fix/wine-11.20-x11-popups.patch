+void set_first_present_surface( struct x11drv_win_data *data, struct window_surface *surface, BOOL replacement )
+{
+    if (data->first_present_surface != surface)
+    {
+        window_surface_add_ref( surface );
+        if (data->first_present_surface) window_surface_release( data->first_present_surface );
+        data->first_present_surface = surface;
+    }
+    do data->first_present_serial = InterlockedIncrement( &first_present_serial );
+    while (!data->first_present_serial);
+    data->first_present_replacement = replacement;
+    data->first_present_ready = data->first_present_uploaded = data->first_present_fallback = FALSE;
