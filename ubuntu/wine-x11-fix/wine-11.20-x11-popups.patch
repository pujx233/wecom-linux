+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <fcntl.h>
+#include <stdlib.h>
+
+#include "x11drv.h"
+#include "sni_event.h"
+
+struct sni_event
+{
+    struct sni_event *next;
+    uint64_t token;
+    unsigned int action;
+    int x, y;
+};
+
+static pthread_mutex_t event_mutex = PTHREAD_MUTEX_INITIALIZER;
+static Display *gui_display, *worker_display;
+static Window collector;
+static Atom event_atom;
+static struct sni_event *event_head, *event_tail;
+
+/* Called only on the Explorer GUI thread, before publishing any DBus item. */
+BOOL sni_events_init(void)
+{
+    Display *display = x11drv_init_thread_data()->display;
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock( &event_mutex );
+    if (gui_display)
+    {
+        ret = gui_display == display;
+        goto done;
+    }
+    if (!(worker_display = XOpenDisplay( DisplayString(display) ))) goto done;
+    fcntl( ConnectionNumber(worker_display), F_SETFD, FD_CLOEXEC );
+    event_atom = XInternAtom( display, "_WINE_SNI_EVENT", False );
+    collector = XCreateWindow( display, DefaultRootWindow(display), 0, 0, 1, 1, 0,
+                               0, InputOnly, CopyFromParent, 0, NULL );
+    /* The worker connection must not send before the server has created the collector. */
+    XSync( display, False );
+    gui_display = display;
+    ret = TRUE;
+done:
+    pthread_mutex_unlock( &event_mutex );
+    return ret;
+}
+
+/* ThreadDetach calls this before closing its display; late worker actions are then rejected. */
+void sni_events_cleanup(void)
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct sni_event *event;
+
+    pthread_mutex_lock( &event_mutex );
+    if (!data || data->display != gui_display) goto done;
+    /* Closing first also completes queued sends before the collector is destroyed. */
+    XCloseDisplay( worker_display );
+    XDestroyWindow( gui_display, collector );
+    XFlush( gui_display );
+    gui_display = worker_display = NULL;
+    collector = 0;
+    event_atom = 0;
+    while ((event = event_head))
+    {
+        event_head = event->next;
+        free( event );
+    }
+    event_tail = NULL;
+done:
+    pthread_mutex_unlock( &event_mutex );
+}
+
+/* Safe on a native pthread: no Wine, Win32, HICON or HWND operation is performed here. */
+BOOL sni_queue_event( uint64_t token, unsigned int action, int x, int y )
+{
+    struct sni_event *event;
+    XEvent wake = {0};
+    BOOL ret = FALSE;
+
+    if (!token || action < SNI_ACTION_ACTIVATE || action > SNI_ACTION_SECONDARY) return FALSE;
+    if (!(event = malloc( sizeof(*event) ))) return FALSE;
+    event->next = NULL;
+    event->token = token;
+    event->action = action;
+    event->x = x;
+    event->y = y;
+
+    pthread_mutex_lock( &event_mutex );
+    if (!gui_display) goto done;
+    if (!event_head)
+    {
+        wake.xclient.type = ClientMessage;
+        wake.xclient.window = collector;
+        wake.xclient.message_type = event_atom;
+        wake.xclient.format = 32;
+        if (!XSendEvent( worker_display, collector, False, NoEventMask, &wake )) goto done;
+        XFlush( worker_display );
+    }
+    if (event_tail) event_tail->next = event;
+    else event_head = event;
+    event_tail = event;
+    ret = TRUE;
+done:
+    pthread_mutex_unlock( &event_mutex );
+    if (!ret) free( event );
+    return ret;
+}
+
+/* Called before the ordinary ClientMessage handler rejects an unregistered XID. */
+BOOL sni_process_event( XClientMessageEvent *event )
+{
+    struct sni_event *pending, *next;
+
+    pthread_mutex_lock( &event_mutex );
+    if (!gui_display || event->display != gui_display || event->window != collector ||
+        event->message_type != event_atom || event->format != 32)
+    {
+        pthread_mutex_unlock( &event_mutex );
+        return FALSE;
+    }
+    pending = event_head;
+    event_head = event_tail = NULL;
+    pthread_mutex_unlock( &event_mutex );
+
+    while (pending)
+    {
+        next = pending->next;
+        /* Backend resolves the generation token again; a deleted item is never dereferenced. */
+        sni_dispatch_event( pending->token, pending->action, pending->x, pending->y );
+        free( pending );
+        pending = next;
+    }
+    return TRUE;
+}
