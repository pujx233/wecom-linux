+static void update_frame_sync_property( struct x11drv_win_data *data )
+{
+    struct x11drv_win_data *owner = NULL;
+    const XID *counters = data->frame_sync_counters;
+    DWORD style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+    DWORD ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
+
+    if (!data->frame_window || !counters[1]) return;
+    if (!(style & (WS_CHILD | WS_THICKFRAME)) && (style & WS_CAPTION) != WS_CAPTION &&
+        (ex_style & (WS_EX_LAYERED | WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) == (WS_EX_LAYERED | WS_EX_TOOLWINDOW))
+        owner = get_win_data( NtUserGetWindowRelative( data->hwnd, GW_OWNER ) );
+    if (owner && owner->frame_sync_counters[1]) counters = owner->frame_sync_counters;
+    XChangeProperty( data->display, data->frame_window,
+                     XInternAtom( data->display, "_NET_WM_SYNC_REQUEST_COUNTER", False ), XA_CARDINAL,
+                     32, PropModeReplace, (const unsigned char *)counters, 2 );
+    release_win_data( owner );
+}
+
+static void update_frame_sync_group( struct x11drv_win_data *data )
+{
+    struct x11drv_win_data *child;
+    HWND *list;
+    int i;
+
+    update_frame_sync_property( data );
+    if (!(list = build_hwnd_list())) return;
+    for (i = 0; list[i] != HWND_BOTTOM; i++)
+    {
+        if (NtUserGetWindowRelative( list[i], GW_OWNER ) != data->hwnd || !(child = get_win_data( list[i] )))
+            continue;
+        update_frame_sync_property( child );
+        release_win_data( child );
+    }
+    free( list );
+}
+
+static void init_frame_sync( struct x11drv_win_data *data )
+{
+#ifdef HAVE_X11_EXTENSIONS_SYNC_H
+    XSyncValue value;
+    Atom protocol;
+    int major, minor;
+
+    if (!data->frame_window ||
+        !is_net_supported( XInternAtom( data->display, "_NET_WM_FRAME_DRAWN", False ) )) return;
+    if (!data->frame_sync_counters[0])
+    {
+        if (!XSyncInitialize( data->display, &major, &minor )) return;
+        XSyncIntToValue( &value, 0 );
+        data->frame_sync_counters[0] = XSyncCreateCounter( data->display, value );
+        data->frame_sync_counters[1] = XSyncCreateCounter( data->display, value );
+    }
+    update_frame_sync_group( data );
+    protocol = XInternAtom( data->display, "_NET_WM_SYNC_REQUEST", False );
+    XChangeProperty( data->display, data->frame_window, x11drv_atom(WM_PROTOCOLS), XA_ATOM,
+                     32, PropModeAppend, (unsigned char *)&protocol, 1 );
+#endif
+}
+
+static void destroy_frame_sync( struct x11drv_win_data *data )
+{
+    XID counters[2] = {data->frame_sync_counters[0], data->frame_sync_counters[1]};
+
+    data->frame_sync_counters[0] = data->frame_sync_counters[1] = 0;
+    data->frame_sync_value = 0;
+    data->frame_sync_request = 0;
+    if (counters[1]) update_frame_sync_group( data );
+#ifdef HAVE_X11_EXTENSIONS_SYNC_H
+    if (counters[0]) XSyncDestroyCounter( data->display, counters[0] );
+    if (counters[1]) XSyncDestroyCounter( data->display, counters[1] );
+#endif
+}
