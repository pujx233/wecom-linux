@@ -707,10 +707,87 @@ static const struct property_desc device_properties[] =
     { &DEVPKEY_Device_SafeRemovalRequiredOverride,  DEVPROP_TYPE_BOOLEAN },
 };
 
+/* Siblings are a view of the parent's current children, not a per-device copy of that list. */
+static LSTATUS query_device_siblings( HKEY hkey, const struct device *dev, struct property *prop )
+{
+    WCHAR parent_id[MAX_PATH], instance_id[MAX_PATH], *children = NULL, *src, *dst, *end;
+    struct property relation;
+    struct device parent;
+    DEVPROPTYPE type;
+    DWORD size = sizeof(parent_id), len;
+    BOOL found = FALSE;
+    HKEY parent_key;
+    LSTATUS err;
+
+    init_property( &relation, &DEVPKEY_Device_Parent, &type, parent_id, &size, TRUE );
+    if ((err = query_property( hkey, L"Properties\\", DEVPROP_TYPE_STRING, &relation )))
+        return err == ERROR_MORE_DATA ? ERROR_INVALID_DATA : err;
+    if (!size || size % sizeof(WCHAR) || parent_id[size / sizeof(WCHAR) - 1]) return ERROR_INVALID_DATA;
+    if ((err = init_device( &parent, parent_id ))) return err;
+    if ((err = open_device_key( HKEY_LOCAL_MACHINE, &parent, KEY_QUERY_VALUE, TRUE, &parent_key )))
+        return err == ERROR_FILE_NOT_FOUND ? ERROR_NOT_FOUND : err;
+
+    size = 0;
+    init_property( &relation, &DEVPKEY_Device_Children, &type, NULL, &size, TRUE );
+    err = query_property( parent_key, L"Properties\\", DEVPROP_TYPE_STRING_LIST, &relation );
+    if (err == ERROR_MORE_DATA)
+    {
+        if (!(children = malloc( size ))) err = ERROR_NOT_ENOUGH_MEMORY;
+        else
+        {
+            relation.buffer = children;
+            err = query_property( parent_key, L"Properties\\", DEVPROP_TYPE_STRING_LIST, &relation );
+            if (err == ERROR_MORE_DATA)
+            {
+                /* The list grew. Its full size is sufficient for a caller retry, without spinning here. */
+                *prop->size = size;
+                *prop->type = DEVPROP_TYPE_STRING_LIST;
+            }
+        }
+    }
+    RegCloseKey( parent_key );
+    if (err) goto done;
+    if (!size || size % sizeof(WCHAR) || children[size / sizeof(WCHAR) - 1])
+    {
+        err = ERROR_INVALID_DATA;
+        goto done;
+    }
+
+    len = swprintf( instance_id, ARRAY_SIZE(instance_id), L"%s\\%s", dev->enumerator, dev->device );
+    if (*dev->instance) swprintf( instance_id + len, ARRAY_SIZE(instance_id) - len, L"\\%s", dev->instance );
+    end = children + size / sizeof(WCHAR);
+    for (src = dst = children; *src; src += len)
+    {
+        len = wcslen( src ) + 1;
+        if (!wcsicmp( src, instance_id )) found = TRUE;
+        else
+        {
+            memmove( dst, src, len * sizeof(WCHAR) );
+            dst += len;
+        }
+        if (src + len == end)
+        {
+            err = ERROR_INVALID_DATA;
+            goto done;
+        }
+    }
+    if (!found) err = ERROR_NOT_FOUND;
+    else
+    {
+        *dst = 0;
+        err = return_property( prop, DEVPROP_TYPE_STRING_LIST, children, (dst - children + 1) * sizeof(WCHAR) );
+    }
+done:
+    free( children );
+    return err;
+}
+
