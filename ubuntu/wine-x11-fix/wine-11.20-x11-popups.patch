     else buffer[count - 1] = DEVPKEY_Device_InstanceId;
+    if (siblings == ERROR_MORE_DATA)
+    {
+        if (capacity < ++count || !buffer) err = ERROR_MORE_DATA;
+        else buffer[count - 1] = DEVPKEY_Device_Siblings;
