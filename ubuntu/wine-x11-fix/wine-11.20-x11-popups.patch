+static void set_frame_sync( struct x11drv_win_data *data, BOOL pending )
+{
+#ifdef HAVE_X11_EXTENSIONS_SYNC_H
+    XSyncValue value;
+
+    if (!data->frame_sync_counters[1]) return;
+    if (pending)
+    {
+        if (data->frame_sync_value & 1) return;
+        data->frame_sync_value++;
+    }
+    else
+    {
+        if (!(data->frame_sync_value & 1) && !data->frame_sync_request) return;
+        /* Drawing uses a separate X connection. Publish only after its pixels have arrived. */
+        XSync( gdi_display, False );
+        data->frame_sync_value = (max( data->frame_sync_value, data->frame_sync_request ) + 2) & ~1ull;
+        if (data->frame_sync_request)
+        {
+            XSyncIntsToValue( &value, data->frame_sync_request, data->frame_sync_request >> 32 );
+            XSyncSetCounter( data->display, data->frame_sync_counters[0], value );
+            data->frame_sync_request = 0;
+        }
+    }
+    XSyncIntsToValue( &value, data->frame_sync_value, data->frame_sync_value >> 32 );
+    XSyncSetCounter( data->display, data->frame_sync_counters[1], value );
+    TRACE( "frame-sync hwnd %p value %llu pending %u\n", data->hwnd,
+           (unsigned long long)data->frame_sync_value, pending );
+    if (pending)
+    {
+        XSync( data->display, False );
+    }
+    else XFlush( data->display );
+#endif
+}
