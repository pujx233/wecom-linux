+#ifdef HAVE_LIBXSHAPE
+static Region create_rectangles_region( XRectangle *rects, int count )
+{
+    Region result, other;
+
+    if (count <= 1)
+    {
+        result = XCreateRegion();
+        if (count) XUnionRectWithRegion( rects, result, result );
+        return result;
+    }
+    /* Avoid repeatedly copying an ever-growing region for complex alpha masks. */
+    result = create_rectangles_region( rects, count / 2 );
+    other = create_rectangles_region( rects + count / 2, count - count / 2 );
+    XUnionRegion( result, other, result );
+    XDestroyRegion( other );
+    return result;
+}
+#endif
+
+static void update_frame_input( struct x11drv_win_data *data )
+{
+#ifdef HAVE_LIBXSHAPE
+    struct x11drv_win_data *child;
+    HWND *list;
+    Region result, input, bounding, window;
+    XRectangle *rects;
+    XWindowAttributes attr;
+    int i, count, order;
+
+    if (!data->frame_window || !(list = build_hwnd_list())) return;
+    result = XCreateRegion();
+    for (i = 0; list[i] != HWND_BOTTOM; i++)
+    {
+        if (!(child = get_win_data( list[i] ))) continue;
+        if (child->whole_window && (child == data || child->frame_owner == data->hwnd) &&
+            (NtUserGetWindowLongW( child->hwnd, GWL_STYLE ) & (WS_VISIBLE | WS_MINIMIZE)) == WS_VISIBLE &&
+            (NtUserGetWindowLongW( child->hwnd, GWL_EXSTYLE ) & (WS_EX_LAYERED | WS_EX_TRANSPARENT)) !=
+                (WS_EX_LAYERED | WS_EX_TRANSPARENT) &&
+            XGetWindowAttributes( data->display, child->whole_window, &attr ))
+        {
+            XRectangle bounds = {0, 0, attr.width, attr.height};
+            window = XCreateRegion();
+            rects = XShapeGetRectangles( data->display, child->whole_window, ShapeInput, &count, &order );
+            input = create_rectangles_region( rects, count );
+            if (rects) XFree( rects );
+            rects = XShapeGetRectangles( data->display, child->whole_window, ShapeBounding, &count, &order );
+            bounding = create_rectangles_region( rects, count );
+            if (rects) XFree( rects );
+            XIntersectRegion( input, bounding, input );
+            XUnionRectWithRegion( &bounds, window, window );
+            XIntersectRegion( input, window, input );
+            XOffsetRegion( input, attr.x, attr.y );
+            XUnionRegion( result, input, result );
+            XDestroyRegion( input );
+            XDestroyRegion( bounding );
+            XDestroyRegion( window );
+        }
+        release_win_data( child );
+    }
+    XShapeCombineRegion( data->display, data->frame_window, ShapeInput, 0, 0, result, ShapeSet );
+    XDestroyRegion( result );
+    free( list );
+#endif
+}
+
+static void configure_owned_frame( struct x11drv_win_data *data, RECT owner_rect, BOOL above, Window sibling )
+{
+    struct x11drv_win_data *child;
+    HWND *list;
+    Window *windows;
+    RECT frame, rect, extents_rect;
+    XWindowAttributes owner_attr, attr;
+    XWindowChanges changes;
+    unsigned long extents[4];
+    POINT point;
+    UINT mask = 0;
+    int i, count = 0, overlays = 0;
+
+    if (!XGetWindowAttributes( data->display, data->whole_window, &owner_attr )) return;
+    if (!(list = build_hwnd_list())) return;
+    if (owner_rect.right - owner_rect.left != owner_attr.width ||
+        owner_rect.bottom - owner_rect.top != owner_attr.height)
+        SetRectEmpty( &data->frame_padding );
+    SetRect( &frame, owner_attr.x, owner_attr.y, owner_attr.x + owner_rect.right - owner_rect.left,
+             owner_attr.y + owner_rect.bottom - owner_rect.top );
+    for (i = 0; list[i] != HWND_BOTTOM; i++)
+    {
+        if (!(child = get_win_data( list[i] ))) continue;
+        if (child->whole_window && child->frame_owner == data->hwnd &&
+            child->desired_state.wm_state == NormalState &&
+            (NtUserGetWindowLongW( child->hwnd, GWL_STYLE ) & (WS_VISIBLE | WS_MINIMIZE)) == WS_VISIBLE &&
+            XGetWindowAttributes( data->display, child->whole_window, &attr ))
+        {
+            frame.left = min( frame.left, attr.x );
+            frame.top = min( frame.top, attr.y );
+            frame.right = max( frame.right, attr.x + attr.width );
+            frame.bottom = max( frame.bottom, attr.y + attr.height );
+        }
+        release_win_data( child );
+    }
+    /* Keep allocated frame padding when an owned layer is temporarily hidden or destroyed. */
+    frame.left = min( frame.left, owner_attr.x - data->frame_padding.left );
+    frame.top = min( frame.top, owner_attr.y - data->frame_padding.top );
+    frame.right = max( frame.right, owner_attr.x + owner_rect.right - owner_rect.left + data->frame_padding.right );
+    frame.bottom = max( frame.bottom, owner_attr.y + owner_rect.bottom - owner_rect.top + data->frame_padding.bottom );
+    windows = malloc( (i + 1) * sizeof(*windows) );
+    if (windows) windows[count++] = data->whole_window;
+    extents[0] = owner_attr.x - frame.left;
+    extents[1] = frame.right - owner_attr.x - (owner_rect.right - owner_rect.left);
+    extents[2] = owner_attr.y - frame.top;
+    extents[3] = frame.bottom - owner_attr.y - (owner_rect.bottom - owner_rect.top);
+    SetRect( &extents_rect, extents[0], extents[2], extents[1], extents[3] );
+    data->frame_padding = extents_rect;
+    if (!EqualRect( &data->frame_extents, &extents_rect ))
+    {
+        data->frame_extents = extents_rect;
+        XChangeProperty( data->display, data->frame_window,
+                         XInternAtom( data->display, "_GTK_FRAME_EXTENTS", False ), XA_CARDINAL,
+                         32, PropModeReplace, (unsigned char *)extents, 4 );
+        set_size_hints( data, NtUserGetWindowLongW( data->hwnd, GWL_STYLE ) );
+    }
+    rect = frame;
+    OffsetRect( &frame, owner_rect.left - owner_attr.x, owner_rect.top - owner_attr.y );
+    point = virtual_screen_to_root( frame.left, frame.top );
+    changes.x = point.x;
+    changes.y = point.y;
+    changes.width = get_native_dimension( frame.left, frame.right );
+    changes.height = get_native_dimension( frame.top, frame.bottom );
+    if (frame.left != data->frame_rect.left || frame.top != data->frame_rect.top || data->restore_position)
+        mask |= CWX | CWY;
+    if (changes.width != get_native_dimension( data->frame_rect.left, data->frame_rect.right ) ||
+        changes.height != get_native_dimension( data->frame_rect.top, data->frame_rect.bottom ))
+        mask |= CWWidth | CWHeight;
+    if (sibling)
+    {
+        changes.sibling = sibling;
+        changes.stack_mode = above ? Above : Below;
+        mask |= CWSibling | CWStackMode;
+    }
+    else if (above && !data->pending_state.above)
+    {
+        changes.stack_mode = Above;
+        mask |= CWStackMode;
+    }
+    for (i = 0; list[i] != HWND_BOTTOM; i++)
+    {
+        if (!(child = get_win_data( list[i] ))) continue;
+        if (child->whole_window && (child == data || child->frame_owner == data->hwnd) &&
+            XGetWindowAttributes( data->display, child->whole_window, &attr ))
+        {
+            int width = child == data ? get_native_dimension( owner_rect.left, owner_rect.right ) : attr.width;
+            int height = child == data ? get_native_dimension( owner_rect.top, owner_rect.bottom ) : attr.height;
+            XMoveResizeWindow( data->display, child->whole_window, attr.x - rect.left, attr.y - rect.top,
+                               width, height );
+            if (windows && child != data)
+            {
+                /* Only declared decorations sit behind the body; preserve content window order. */
+                if (!is_frame_decoration( child->hwnd ))
+                {
+                    memmove( windows + overlays + 1, windows + overlays, (count - overlays) * sizeof(*windows) );
+                    windows[overlays++] = child->whole_window;
+                    count++;
+                }
+                else windows[count++] = child->whole_window;
+            }
+        }
+        release_win_data( child );
+    }
+    if (count > 1) XRestackWindows( data->display, windows, count );
+    free( windows );
+    free( list );
+    data->frame_rect = frame;
+    if (mask)
+    {
+        if (mask & (CWX | CWY | CWWidth | CWHeight)) data->configure_serial = NextRequest( data->display );
+        XReconfigureWMWindow( data->display, data->frame_window, data->vis.screen, mask, &changes );
+        data->restore_position = FALSE;
+    }
+    update_frame_input( data );
+}
+
+int owned_frame_event( XEvent *event )
+{
+    struct x11drv_win_data *data;
+    struct host_window *host;
+    XWindowAttributes attr, frame_attr;
+    HWND hwnd;
+    Window child;
+    int x, y, result = 0;
+
+    if (XFindContext( event->xany.display, event->xany.window, winContext, (char **)&hwnd )) return 0;
+    if (!(data = get_win_data( hwnd ))) return 0;
+    if (event->xany.window != data->frame_window)
+    {
+        if (data->frame_window && (event->type == PropertyNotify || event->type == MapNotify ||
+                                   event->type == UnmapNotify)) result = -1;
+        goto done;
+    }
+    result = 1;
+    if (event->type == Expose && !event->xexpose.count && data->frame_composite)
+        composite_owned_frame( data->hwnd, FALSE );
+    if (event->type == ReparentNotify)
+    {
+        if ((host = get_host_window( data->frame_window, FALSE )))
+            host_window_set_parent( host, event->xreparent.parent );
+        result = -1;
+    }
+    else if (event->type == ConfigureNotify)
+    {
+        if ((host = get_host_window( data->frame_window, FALSE )))
+        {
+            RECT rect;
+            SetRect( &rect, event->xconfigure.x, event->xconfigure.y,
+                     event->xconfigure.x + event->xconfigure.width,
+                     event->xconfigure.y + event->xconfigure.height );
+            if (host->parent)
+                rect = host_window_configure_child( host->parent, host->window, rect, event->xconfigure.send_event );
+            host->rect = rect;
+        }
+        if (XGetWindowAttributes( data->display, data->whole_window, &attr ) &&
+            XTranslateCoordinates( data->display, data->whole_window, root_window, 0, 0, &x, &y, &child ))
+        {
+            POINT origin = root_to_virtual_screen( x - attr.x, y - attr.y );
+            if (XGetWindowAttributes( data->display, data->frame_window, &frame_attr ))
+            {
+                SetRect( &data->frame_rect, origin.x, origin.y,
+                         origin.x + frame_attr.width, origin.y + frame_attr.height );
+                if (attr.width != max( 1, frame_attr.width - data->frame_extents.left - data->frame_extents.right ) ||
+                    attr.height != max( 1, frame_attr.height - data->frame_extents.top - data->frame_extents.bottom ))
+                    composite_owned_frame( data->hwnd, TRUE );
+                attr.width = max( 1, frame_attr.width - data->frame_extents.left - data->frame_extents.right );
+                attr.height = max( 1, frame_attr.height - data->frame_extents.top - data->frame_extents.bottom );
+            }
+            event->xconfigure.window = data->whole_window;
+            event->xconfigure.send_event = True;
+            event->xconfigure.x = x;
+            event->xconfigure.y = y;
+            event->xconfigure.width = attr.width;
+            event->xconfigure.height = attr.height;
+        }
+    }
+done:
+    release_win_data( data );
+    return result;
+}
