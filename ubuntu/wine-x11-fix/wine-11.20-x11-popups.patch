+/* Snapshot native output rectangles without changing the server or foreign tray windows. */
+int xembed_get_outputs( struct xembed_output *outputs, unsigned int capacity, unsigned long *timestamp )
+{
+#ifdef HAVE_XRRGETPROVIDERRESOURCES
+    XRRScreenResources *resources;
+    XRROutputInfo *output;
+    XRRCrtcInfo *crtc;
+    unsigned int count = 0;
+    int i, valid = 1;
+
+    if (!pXRRGetOutputInfo || !(resources = xrandr_get_screen_resources())) return 0;
+    memset( outputs, 0, capacity * sizeof(*outputs) );
+    *timestamp = resources->configTimestamp;
+    for (i = 0; i < resources->noutput && valid; i++)
+    {
+        if (!(output = pXRRGetOutputInfo( gdi_display, resources, resources->outputs[i] ))) break;
+        if (output->connection == RR_Connected && output->crtc)
+        {
+            crtc = pXRRGetCrtcInfo( gdi_display, resources, output->crtc );
+            if (!crtc || !crtc->mode || count == capacity || output->nameLen >= sizeof(outputs[0].name)) valid = 0;
+            else
+            {
+                memcpy( outputs[count].name, output->name, output->nameLen );
+                outputs[count].x = crtc->x;
+                outputs[count].y = crtc->y;
+                outputs[count].width = crtc->width;
+                outputs[count++].height = crtc->height;
+            }
+            if (crtc) pXRRFreeCrtcInfo( crtc );
+        }
+        pXRRFreeOutputInfo( output );
+    }
+    valid = valid && i == resources->noutput;
+    pXRRFreeScreenResources( resources );
+    return valid ? count : 0;
+#else
+    return 0;
+#endif
+}
