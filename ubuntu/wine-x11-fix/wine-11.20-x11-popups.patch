+static void trace_surface_pixels( struct window_surface *surface, const RECT *dirty,
+                                  const BITMAPINFO *info, const void *bits )
+{
+    const BITMAPINFOHEADER *header = &info->bmiHeader;
+    const DWORD *masks = (const DWORD *)info->bmiColors;
+    UINT height, stride, cols, rows, x, y, nonwhite = 0, nonblack = 0;
+    ULONGLONG hash = 0xcbf29ce484222325ull;
+    DWORD rgb_mask = 0x00ffffff;
+    RECT rect;
+
+    if (header->biSize != sizeof(*header) || header->biPlanes != 1 || header->biBitCount != 32 ||
+        (header->biCompression != BI_RGB && header->biCompression != BI_BITFIELDS) ||
+        header->biWidth <= 0 || !header->biHeight || header->biHeight == (-2147483647 - 1)) return;
+    height = header->biHeight < 0 ? -header->biHeight : header->biHeight;
+    if (!header->biSizeImage || header->biSizeImage % height) return;
+    stride = header->biSizeImage / height;
+    if ((ULONGLONG)header->biWidth * 4 > stride) return;
+    if (header->biCompression == BI_BITFIELDS)
+    {
+        if (!masks[0] || !masks[1] || !masks[2] ||
+            (masks[0] & masks[1]) || (masks[0] & masks[2]) || (masks[1] & masks[2])) return;
+        rgb_mask = masks[0] | masks[1] | masks[2];
+    }
+    SetRect( &rect, 0, 0, min(header->biWidth, surface->rect.right - surface->rect.left),
+             min(height, surface->rect.bottom - surface->rect.top) );
+    if (!intersect_rect( &rect, &rect, dirty )) return;
+    cols = min(32, rect.right - rect.left);
+    rows = min(32, rect.bottom - rect.top);
+    for (y = 0; y < rows; y++)
+    {
+        UINT row = rect.top + (ULONGLONG)(2 * y + 1) * (rect.bottom - rect.top) / (2 * rows);
+        const BYTE *line;
+
+        if (header->biHeight > 0) row = height - 1 - row;
+        line = (const BYTE *)bits + (SIZE_T)row * stride;
+        for (x = 0; x < cols; x++)
+        {
+            UINT col = rect.left + (ULONGLONG)(2 * x + 1) * (rect.right - rect.left) / (2 * cols);
+            DWORD pixel;
+            UINT i;
+
+            memcpy( &pixel, line + (SIZE_T)col * 4, sizeof(pixel) );
+            pixel &= rgb_mask;
+            nonwhite += pixel != rgb_mask;
+            nonblack += pixel != 0;
+            for (i = 0; i < 4; i++) hash = (hash ^ ((pixel >> (8 * i)) & 0xff)) * 0x100000001b3ull;
+        }
+    }
+    TRACE_(paint)( "surface-samples hwnd %p dirty %s sample %s count %u nonwhite %u nonblack %u hash %016llx\n",
+                   surface->hwnd, wine_dbgstr_rect(dirty), wine_dbgstr_rect(&rect), cols * rows,
+                   nonwhite, nonblack, (unsigned long long)hash );
+}
