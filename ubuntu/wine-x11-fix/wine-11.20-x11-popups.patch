+                 p_dbus_message_iter_close_container( &iter, &array ) &&
+                 p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "i", &array ) &&
+                 p_dbus_message_iter_close_container( &iter, &array );
+        }
+        else goto unknown;
+    }
+    else goto unknown;
+    pthread_mutex_unlock( &mutex );
+    if (ok) ok = p_dbus_connection_send( connection, reply, NULL );
+    p_dbus_message_unref( reply );
+    return ok ? DBUS_HANDLER_RESULT_HANDLED : DBUS_HANDLER_RESULT_NEED_MEMORY;
+unknown:
+    pthread_mutex_unlock( &mutex );
+    p_dbus_message_unref( reply );
+    if (!(reply = p_dbus_message_new_error( message, DBUS_ERROR_UNKNOWN_METHOD, "Unknown SNI operation" )))
+        return DBUS_HANDLER_RESULT_NEED_MEMORY;
+    ok = p_dbus_connection_send( connection, reply, NULL );
+    p_dbus_message_unref( reply );
+    return ok ? DBUS_HANDLER_RESULT_HANDLED : DBUS_HANDLER_RESULT_NEED_MEMORY;
+}
+
+static void register_item( DBusConnection *connection )
+{
+    const char *path = ITEM_PATH;
+    DBusMessage *message = p_dbus_message_new_method_call( SNI_WATCHER, "/StatusNotifierWatcher", SNI_WATCHER,
+                                                         "RegisterStatusNotifierItem" );
+    if (!message) return;
+    p_dbus_message_set_no_reply( message, TRUE );
+    if (p_dbus_message_append_args( message, DBUS_TYPE_STRING, &path, DBUS_TYPE_INVALID ))
+        p_dbus_connection_send( connection, message, NULL );
+    p_dbus_message_unref( message );
+}
+
+static DBusHandlerResult watcher_changed( DBusConnection *connection, DBusMessage *message, void *data )
+{
+    const char *name, *old_owner, *new_owner;
+    if (p_dbus_message_is_signal( message, DBUS_INTERFACE_DBUS, "NameOwnerChanged" ) &&
+        p_dbus_message_get_args( message, NULL, DBUS_TYPE_STRING, &name, DBUS_TYPE_STRING, &old_owner,
+                                 DBUS_TYPE_STRING, &new_owner, DBUS_TYPE_INVALID ) &&
+        !strcmp( name, SNI_WATCHER ) && *new_owner) register_item( connection );
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static void send_signal( DBusConnection *connection, const char *name, const char *status )
+{
+    DBusMessage *message = p_dbus_message_new_signal( ITEM_PATH, SNI_ITEM, name );
+    if (!message) return;
+    if (!status || p_dbus_message_append_args( message, DBUS_TYPE_STRING, &status, DBUS_TYPE_INVALID ))
+        p_dbus_connection_send( connection, message, NULL );
+    p_dbus_message_unref( message );
+}
+
+static void wake_worker(void)
+{
+    unsigned char byte = 0;
+    ssize_t ret;
+    if (wake_pipe[1] >= 0)
+        do ret = write( wake_pipe[1], &byte, 1 ); while (ret < 0 && errno == EINTR);
+}
+
+static void *run_worker( void *arg )
+{
+    for (;;)
+    {
+        struct sni_item *item;
+        DBusConnection **connections;
+        struct pollfd *fds;
+        unsigned char bytes[128];
+        unsigned int count = 0, index = 0;
+
+        pthread_mutex_lock( &mutex );
+        if (stopping)
+        {
+            pthread_mutex_unlock( &mutex );
+            return NULL;
+        }
+        for (item = items; item; item = item->next) count++;
+        connections = calloc( count, sizeof(*connections) );
+        fds = calloc( count + 1, sizeof(*fds) );
+        if (!fds || (count && !connections))
+        {
+            struct pollfd wake = {.fd = wake_pipe[0], .events = POLLIN};
+            pthread_mutex_unlock( &mutex );
+            free( connections );
+            free( fds );
+            poll( &wake, 1, 100 );
+            continue;
+        }
+        fds[0].fd = wake_pipe[0];
+        fds[0].events = POLLIN;
+        for (item = items; item; item = item->next)
+        {
+            DBusConnection *connection = item->connection;
+            connections[index] = p_dbus_connection_ref( connection );
+            fds[index + 1].fd = -1;
+            p_dbus_connection_get_unix_fd( connection, &fds[index + 1].fd );
+            fds[index + 1].events = POLLIN;
+            if (item->dirty & DIRTY_REGISTER) register_item( connection );
+            if (item->dirty & DIRTY_ICON) send_signal( connection, "NewIcon", NULL );
+            if (item->dirty & DIRTY_TIP)
+            {
+                send_signal( connection, "NewToolTip", NULL );
+                send_signal( connection, "NewTitle", NULL );
+            }
+            if (item->dirty & DIRTY_STATUS)
+                send_signal( connection, "NewStatus", item->hidden ? "Passive" : "Active" );
+            item->dirty = 0;
+            index++;
+        }
+        pthread_mutex_unlock( &mutex );
+        for (index = 0; index < count; index++)
+        {
+            if (p_dbus_connection_read_write( connections[index], 0 ))
+            {
+                while (p_dbus_connection_dispatch( connections[index] ) == DBUS_DISPATCH_DATA_REMAINS) {}
+                if (p_dbus_connection_get_outgoing_size( connections[index] )) fds[index + 1].events |= POLLOUT;
+            }
+            else fds[index + 1].fd = -1;
+        }
+        poll( fds, count + 1, -1 );
+        if (fds[0].revents) while (read( wake_pipe[0], bytes, sizeof(bytes) ) > 0) {}
+        for (index = 0; index < count; index++) p_dbus_connection_unref( connections[index] );
+        free( connections );
+        free( fds );
+    }
+}
+
+static unsigned char *copy_pixels( unsigned int width, unsigned int height, const unsigned char *argb )
+{
+    unsigned char *copy;
+    size_t size;
+    if (!argb || !width || !height) return NULL;
+    if (width > 1024 || height > 1024) return NULL;
+    size = width * height * 4;
+    if (!(copy = malloc( size ))) return NULL;
+    memcpy( copy, argb, size );
+    return copy;
+}
+
+static void free_item( struct sni_item *item )
+{
+    if (item->connection)
+    {
+        p_dbus_connection_close( item->connection );
+        p_dbus_connection_unref( item->connection );
+    }
+    free( item->argb );
+    free( item->title );
+    free( item->id );
+    free( item );
+}
+
+int sni_dbus_add( uint64_t token, const char *id, const char *title, unsigned int width,
+                  unsigned int height, const unsigned char *argb, int hidden )
+{
+    static const DBusObjectPathVTable vtable = {.message_function = handle_method};
+    static const char match[] = "type='signal',sender='org.freedesktop.DBus',"
+        "interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='org.kde.StatusNotifierWatcher'";
+    struct sni_item *item;
+    DBusError error;
+    int ok;
+
+    if (!load_dbus()) return 0;
+    if (!(item = calloc( 1, sizeof(*item) ))) return 0;
+    item->token = token;
+    item->width = width;
+    item->height = height;
+    item->hidden = hidden;
+    item->dirty = DIRTY_REGISTER;
+    if (!(item->id = strdup( id )) || !(item->title = strdup( title ? title : "Wine application" ))) goto failed;
+    item->argb = copy_pixels( width, height, argb );
+    if (argb && width && height && !item->argb) goto failed;
+    p_dbus_error_init( &error );
+    if (!(item->connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error ))) goto dbus_failed;
+    p_dbus_connection_set_exit_on_disconnect( item->connection, FALSE );
+    if (!p_dbus_bus_name_has_owner( item->connection, SNI_WATCHER, &error )) goto dbus_failed;
+    if (!p_dbus_connection_register_object_path( item->connection, ITEM_PATH, &vtable, (void *)(uintptr_t)token ) ||
+        !p_dbus_connection_register_object_path( item->connection, MENU_PATH, &vtable, (void *)(uintptr_t)token ) ||
+        !p_dbus_connection_add_filter( item->connection, watcher_changed, NULL, NULL )) goto dbus_failed;
+    p_dbus_bus_add_match( item->connection, match, &error );
+    if (p_dbus_error_is_set( &error )) goto dbus_failed;
+    pthread_mutex_lock( &mutex );
+    if (find_item( token ) || stopping)
+    {
+        pthread_mutex_unlock( &mutex );
+        goto failed;
+    }
+    if (!worker_running)
+    {
+        if (pipe2( wake_pipe, O_NONBLOCK | O_CLOEXEC ))
+        {
+            pthread_mutex_unlock( &mutex );
+            goto failed;
+        }
+        if (!(ok = !pthread_create( &worker, NULL, run_worker, NULL )))
+        {
+            close( wake_pipe[0] );
+            close( wake_pipe[1] );
+            wake_pipe[0] = wake_pipe[1] = -1;
+            pthread_mutex_unlock( &mutex );
+            goto failed;
+        }
+        worker_running = 1;
+    }
+    item->next = items;
+    items = item;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    return 1;
+dbus_failed:
+    if (p_dbus_error_is_set( &error )) p_dbus_error_free( &error );
+failed:
+    free_item( item );
+    return 0;
+}
+
+int sni_dbus_update( uint64_t token, const char *title, unsigned int width, unsigned int height,
+                     const unsigned char *argb, int hidden )
+{
+    struct sni_item *item;
+    unsigned char *pixels = copy_pixels( width, height, argb );
+    char *text = title ? strdup( title ) : NULL;
+
+    if ((title && !text) || (argb && width && height && !pixels)) goto failed;
+    pthread_mutex_lock( &mutex );
+    if (!(item = find_item( token )))
+    {
+        pthread_mutex_unlock( &mutex );
+        goto failed;
+    }
+    if (title)
+    {
+        free( item->title );
+        item->title = text;
+        item->dirty |= DIRTY_TIP;
+    }
+    if (argb)
+    {
+        free( item->argb );
+        item->argb = pixels;
+        item->width = width;
+        item->height = height;
+        item->dirty |= DIRTY_ICON;
+    }
+    if (item->hidden != hidden)
+    {
+        item->hidden = hidden;
+        item->pending_action = 0;
+        item->menu_open = 0;
+        item->dirty |= DIRTY_STATUS;
+    }
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    return 1;
+failed:
+    free( text );
+    free( pixels );
+    return 0;
+}
+
+void sni_dbus_remove( uint64_t token )
+{
+    struct sni_item **link, *item;
+    pthread_mutex_lock( &mutex );
+    for (link = &items; *link; link = &(*link)->next) if ((*link)->token == token) break;
+    item = *link;
+    if (item) *link = item->next;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    if (item) free_item( item );
+}
+
+void sni_dbus_cleanup(void)
+{
+    struct sni_item *item, *next;
+    int join;
+    pthread_mutex_lock( &mutex );
+    stopping = 1;
+    join = worker_running;
+    wake_worker();
+    pthread_mutex_unlock( &mutex );
+    if (join) pthread_join( worker, NULL );
+    pthread_mutex_lock( &mutex );
+    for (item = items; item; item = next)
+    {
+        next = item->next;
+        free_item( item );
+    }
+    items = NULL;
+    if (wake_pipe[0] >= 0) close( wake_pipe[0] );
+    if (wake_pipe[1] >= 0) close( wake_pipe[1] );
+    wake_pipe[0] = wake_pipe[1] = -1;
+    worker_running = stopping = 0;
+    pthread_mutex_unlock( &mutex );
+}
+
+static int read_basic( DBusMessageIter *iter, int type, void *value )
+{
+    if (p_dbus_message_iter_get_arg_type( iter ) != type) return 0;
+    p_dbus_message_iter_get_basic( iter, value );
+    p_dbus_message_iter_next( iter );
+    return 1;
+}
+
+static int read_container( DBusMessageIter *iter, int type, DBusMessageIter *contents )
+{
+    if (p_dbus_message_iter_get_arg_type( iter ) != type) return 0;
+    p_dbus_message_iter_recurse( iter, contents );
+    p_dbus_message_iter_next( iter );
+    return 1;
+}
+
+static int read_property( DBusMessageIter properties, const char *name, int type, void *value )
+{
+    DBusMessageIter entry, variant;
+    const char *key;
+
+    while (read_container( &properties, DBUS_TYPE_DICT_ENTRY, &entry ))
+        if (read_basic( &entry, DBUS_TYPE_STRING, &key ) && !strcmp( key, name ) &&
+            read_container( &entry, DBUS_TYPE_VARIANT, &variant )) return read_basic( &variant, type, value );
+    return 0;
+}
+
+static DBusMessage *call_mutter( DBusConnection *connection, const char *path, const char *interface,
+                               const char *method, int property )
+{
+    const char *name = "UiScalingFactor", *x11 = "org.gnome.Mutter.X11";
+    DBusMessage *message, *reply;
+
+    if (!(message = p_dbus_message_new_method_call( property ? x11 : "org.gnome.Mutter.DisplayConfig",
+                                                   path, interface, method ))) return NULL;
+    p_dbus_message_set_auto_start( message, FALSE );
+    if (property && !p_dbus_message_append_args( message, DBUS_TYPE_STRING, &x11, DBUS_TYPE_STRING, &name,
+                                                DBUS_TYPE_INVALID ))
+    {
+        p_dbus_message_unref( message );
+        return NULL;
+    }
+    reply = p_dbus_connection_send_with_reply_and_block( connection, message, 250, NULL );
+    p_dbus_message_unref( message );
+    return reply;
+}
+
+static int output_index( const struct xembed_output *outputs, unsigned int count, const char *connector )
+{
+    unsigned int index;
+    for (index = 0; index < count; index++) if (!strcmp( outputs[index].name, connector )) return index;
+    return -1;
+}
+
+static int read_current_modes( DBusMessageIter monitors, const struct xembed_output *outputs, unsigned int count,
+                               int *widths, int *heights )
+{
+    DBusMessageIter monitor, spec, modes, mode, flags;
+    dbus_bool_t current;
+    const char *connector;
+    int index, width, height, found;
+
+    while (read_container( &monitors, DBUS_TYPE_STRUCT, &monitor ))
+    {
+        if (!read_container( &monitor, DBUS_TYPE_STRUCT, &spec ) ||
+            !read_basic( &spec, DBUS_TYPE_STRING, &connector )) return 0;
+        if ((index = output_index( outputs, count, connector )) < 0) continue;
+        if (widths[index] || !read_container( &monitor, DBUS_TYPE_ARRAY, &modes )) return 0;
+        found = 0;
+        while (read_container( &modes, DBUS_TYPE_STRUCT, &mode ))
+        {
+            p_dbus_message_iter_next( &mode ); /* mode id */
+            if (!read_basic( &mode, DBUS_TYPE_INT32, &width ) ||
+                !read_basic( &mode, DBUS_TYPE_INT32, &height )) return 0;
+            p_dbus_message_iter_next( &mode ); /* refresh rate */
+            p_dbus_message_iter_next( &mode ); /* preferred scale */
+            p_dbus_message_iter_next( &mode ); /* supported scales */
+            if (!read_container( &mode, DBUS_TYPE_ARRAY, &flags )) return 0;
+            if (read_property( flags, "is-current", DBUS_TYPE_BOOLEAN, &current ) && current)
+            {
+                if (found++ || width <= 0 || height <= 0) return 0;
+                widths[index] = width;
+                heights[index] = height;
+            }
+        }
+        if (!found) return 0;
+    }
+    return 1;
+}
+
+static int validate_logical_outputs( DBusMessageIter logical, const struct xembed_output *outputs,
+                                     unsigned int count, unsigned int layout, int scale,
+                                     const int *widths, const int *heights, int x, int y )
+{
+    DBusMessageIter monitor, connectors, spec;
+    unsigned int transform, seen = 0;
+    const char *connector;
+    double monitor_scale;
+    int index, lx, ly, width, height, swap, contains = 0;
+    dbus_bool_t primary;
+
+    while (read_container( &logical, DBUS_TYPE_STRUCT, &monitor ))
+    {
+        if (!read_basic( &monitor, DBUS_TYPE_INT32, &lx ) || !read_basic( &monitor, DBUS_TYPE_INT32, &ly ) ||
+            !read_basic( &monitor, DBUS_TYPE_DOUBLE, &monitor_scale ) ||
+            !read_basic( &monitor, DBUS_TYPE_UINT32, &transform ) ||
+            !read_basic( &monitor, DBUS_TYPE_BOOLEAN, &primary ) ||
+            !read_container( &monitor, DBUS_TYPE_ARRAY, &connectors ) || transform > 7 ||
+            !isfinite(monitor_scale) || monitor_scale <= 0 || monitor_scale > 8) return 0;
+        while (read_container( &connectors, DBUS_TYPE_STRUCT, &spec ))
+        {
+            if (!read_basic( &spec, DBUS_TYPE_STRING, &connector ) ||
+                (index = output_index( outputs, count, connector )) < 0 || (seen & (1u << index)) ||
+                !widths[index] || !heights[index]) return 0;
+            width = widths[index];
+            height = heights[index];
+            if (transform & 1) { swap = width; width = height; height = swap; }
+            if (layout == 1)
+            {
+                if (width / monitor_scale > INT_MAX || height / monitor_scale > INT_MAX) return 0;
+                width = round( width / monitor_scale );
+                height = round( height / monitor_scale );
+            }
+            if ((int64_t)lx * scale != outputs[index].x || (int64_t)ly * scale != outputs[index].y ||
+                (int64_t)width * scale != outputs[index].width ||
+                (int64_t)height * scale != outputs[index].height) return 0;
+            if (x >= lx && y >= ly && (int64_t)x < (int64_t)lx + width && (int64_t)y < (int64_t)ly + height)
+                contains = 1;
+            seen |= 1u << index;
+        }
+    }
+    return contains && seen == (count == 32 ? UINT32_MAX : (1u << count) - 1);
+}
+
+/* Only the read-only, fully matched Mutter/XRandR contract permits scaling a synthetic tray point. */
+int sni_dbus_map_xembed_point( const struct xembed_output *outputs, unsigned int count, int *x, int *y )
+{
+    static const char state_signature[] = "ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv}";
+    DBusMessage *state = NULL, *factor = NULL, *after = NULL;
+    DBusMessageIter iter, monitors, logical, properties, variant;
+    DBusConnection *connection = NULL;
+    int widths[32] = {0}, heights[32] = {0}, scale, valid = 0;
+    dbus_uint32_t serial, current_serial, layout = 1;
+
+    if (!count || count > 32 || !getenv( "DBUS_SESSION_BUS_ADDRESS" )) return 0;
+    pthread_mutex_lock( &mutex );
+    valid = load_dbus();
+    pthread_mutex_unlock( &mutex );
+    if (!valid) return 0;
+    valid = 0;
+    if (!(connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, NULL ))) goto done;
+    p_dbus_connection_set_exit_on_disconnect( connection, FALSE );
+    state = call_mutter( connection, "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig",
+                         "GetCurrentState", 0 );
+    factor = call_mutter( connection, "/org/gnome/Mutter/X11", DBUS_INTERFACE_PROPERTIES, "Get", 1 );
+    if (!state || !factor || strcmp( p_dbus_message_get_signature( state ), state_signature ) ||
+        strcmp( p_dbus_message_get_signature( factor ), "v" ) || !p_dbus_message_get_sender( state ) ||
+        !p_dbus_message_get_sender( factor ) ||
+        strcmp( p_dbus_message_get_sender( state ), p_dbus_message_get_sender( factor ) )) goto done;
+    p_dbus_message_iter_init( factor, &iter );
+    if (!read_container( &iter, DBUS_TYPE_VARIANT, &variant ) ||
+        !read_basic( &variant, DBUS_TYPE_INT32, &scale ) || scale < 1 || scale > 8) goto done;
+    p_dbus_message_iter_init( state, &iter );
+    if (!read_basic( &iter, DBUS_TYPE_UINT32, &serial ) ||
+        !read_container( &iter, DBUS_TYPE_ARRAY, &monitors ) ||
+        !read_container( &iter, DBUS_TYPE_ARRAY, &logical ) ||
+        !read_container( &iter, DBUS_TYPE_ARRAY, &properties )) goto done;
+    read_property( properties, "layout-mode", DBUS_TYPE_UINT32, &layout );
+    if (layout == 2) scale = 1;
+    else if (layout != 1) goto done;
+    if (!read_current_modes( monitors, outputs, count, widths, heights ) ||
+        !validate_logical_outputs( logical, outputs, count, layout, scale, widths, heights, *x, *y )) goto done;
+    after = call_mutter( connection, "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig",
+                         "GetCurrentState", 0 );
+    if (!after || strcmp( p_dbus_message_get_signature( after ), state_signature ) ||
+        !p_dbus_message_get_sender( after ) ||
+        strcmp( p_dbus_message_get_sender( state ), p_dbus_message_get_sender( after ) )) goto done;
+    p_dbus_message_iter_init( after, &iter );
+    if (!read_basic( &iter, DBUS_TYPE_UINT32, &current_serial ) || serial != current_serial ||
+        (int64_t)*x * scale < INT_MIN || (int64_t)*x * scale > INT_MAX ||
+        (int64_t)*y * scale < INT_MIN || (int64_t)*y * scale > INT_MAX) goto done;
+    *x *= scale;
+    *y *= scale;
+    valid = 1;
+done:
+    if (after) p_dbus_message_unref( after );
+    if (factor) p_dbus_message_unref( factor );
+    if (state) p_dbus_message_unref( state );
+    if (connection)
+    {
+        p_dbus_connection_close( connection );
+        p_dbus_connection_unref( connection );
+    }
+    return valid;
+}
+
+#else
+int sni_dbus_add( uint64_t token, const char *id, const char *title, unsigned int width,
+                  unsigned int height, const unsigned char *argb, int hidden ) { return 0; }
+int sni_dbus_update( uint64_t token, const char *title, unsigned int width, unsigned int height,
+                     const unsigned char *argb, int hidden ) { return 0; }
+void sni_dbus_remove( uint64_t token ) {}
+void sni_dbus_cleanup(void) {}
+int sni_dbus_map_xembed_point( const struct xembed_output *outputs, unsigned int count, int *x, int *y )
+{
+    return 0;
+}
+#endif
