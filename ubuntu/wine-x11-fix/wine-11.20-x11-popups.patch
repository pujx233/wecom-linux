+void complete_surface_paint( HWND hwnd, UINT action, struct window_surface *surface )
+{
+    struct window_surface *driver_surface = NULL;
+    WND *win;
+    LRESULT serial;
+
+    if (surface)
+    {
+        struct ratio monitor_dpi;
+        BOOL current = FALSE;
+
+        if ((win = get_win_ptr( hwnd )) && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
+        {
+            current = win->surface == surface;
+            release_win_ptr( win );
+        }
+        if (!current) return;
+        get_win_monitor_dpi( hwnd, &monitor_dpi );
+        driver_surface = get_driver_window_surface( surface, monitor_dpi );
+    }
+    if (!(serial = user_driver->pWindowMessage( hwnd, WM_WINE_SURFACE_PAINT, action, (LPARAM)driver_surface ))) return;
+    if (surface) window_surface_add_ref( surface );
+    else if ((win = get_win_ptr( hwnd )) && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
+    {
+        if ((surface = win->surface)) window_surface_add_ref( surface );
+        release_win_ptr( win );
+    }
+    if (!surface) return;
+    window_surface_flush( surface );
+    window_surface_release( surface );
+    if (serial != -1) user_driver->pWindowMessage( hwnd, WM_WINE_SURFACE_PAINT, WINE_SURFACE_COMMIT, serial );
+}
 
