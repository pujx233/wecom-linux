+/* Applications may declare their decoration classes; window styles do not identify a shadow. */
+static BOOL is_frame_decoration( HWND hwnd )
+{
+    const char *classes = getenv( "WINE_X11_FRAME_DECORATION_CLASSES" ), *end;
+    WCHAR name[256];
+    char utf8[ARRAY_SIZE(name) * 3];
+    UNICODE_STRING name_str = {0, sizeof(name), name};
+    ULONG size;
+    int length;
+
+    if (!classes || !(length = NtUserGetClassName( hwnd, FALSE, &name_str ))) return FALSE;
+    if (RtlUnicodeToUTF8N( utf8, sizeof(utf8), &size, name, length * sizeof(WCHAR) )) return FALSE;
+    do
+    {
+        end = strchr( classes, ';' );
+        if ((end ? end - classes : strlen( classes )) == size && !memcmp( classes, utf8, size )) return TRUE;
+        if (end) classes = end + 1;
+    } while (end);
+    return FALSE;
