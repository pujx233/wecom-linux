+/* An unmapped window clips image uploads. Keep the bounds dirty until the native map is complete. */
+BOOL window_surface_can_present( HWND hwnd, Window window, struct window_surface *surface )
+{
+    struct x11drv_win_data *data;
+    XWindowAttributes attr;
+    BOOL pending = FALSE, mapped, hold = FALSE;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        pending = data->whole_window == window && data->first_present_surface == surface;
+        hold = pending && (data->first_present_argb || data->first_present_replacement) &&
+               !data->first_present_ready;
+        release_win_data( data );
+    }
+    if (hold)
+    {
+        TRACE( "first-present defer pending surface hwnd %p/%lx\n", hwnd, window );
+        return FALSE;
+    }
+    if (!pending) return TRUE;
+    X11DRV_expect_error( gdi_display, host_window_error, NULL );
+    mapped = XGetWindowAttributes( gdi_display, window, &attr ) && attr.map_state == IsViewable;
+    if (X11DRV_check_error()) mapped = FALSE;
+    if (!mapped) TRACE( "first-present defer unmapped hwnd %p/%lx\n", hwnd, window );
+    return mapped;
+}
