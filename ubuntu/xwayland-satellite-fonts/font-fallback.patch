+#[cfg(all(test, feature = "fontconfig"))]
+mod title_tests {
+    use super::{title_font, title_pixmap};
+    use ab_glyph::Font;
+
+    #[test]
+    fn cjk_titles_use_distinct_glyphs() {
+        let mut rendered = Vec::new();
+        let output = std::env::var_os("SATELLITE_QA_RENDER_DIR").map(std::path::PathBuf::from);
+        if let Some(path) = &output {
+            std::fs::create_dir_all(path).unwrap();
+            title_pixmap("Wine - ASCII title", 500, 25, 1.0)
+                .unwrap()
+                .save_png(path.join("latin.png"))
+                .unwrap();
+        }
+        for c in "中文目录".chars() {
+            assert_ne!(title_font(c).glyph_id(c).0, 0, "No installed font covers {c}");
+            let pixmap = title_pixmap(&c.to_string(), 100, 25, 1.0).unwrap();
+            assert!(pixmap.pixels().iter().any(|pixel| pixel.alpha() > 0));
+            if let Some(path) = &output {
+                pixmap.save_png(path.join(format!("{c}.png"))).unwrap();
+            }
+            rendered.push(pixmap.data().to_vec());
+        }
+        rendered.sort();
+        rendered.dedup();
+        assert_eq!(rendered.len(), 4, "Chinese characters must not share the missing-glyph box");
+    }
+
+    #[test]
