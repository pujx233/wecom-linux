+#[cfg(feature = "fontconfig")]
+static FALLBACK_FONTS: LazyLock<Vec<FallbackFont>> = LazyLock::new(|| {
+    let fc = fontconfig::Fontconfig::new().expect("Failed to initialize fontconfig.");
+    let mut pattern = fontconfig::Pattern::new(&fc);
+    pattern.add_string(c"family", c"opensans");
+    pattern
+        .sort_fonts(true)
+        .iter()
+        .filter_map(|font| {
+            Some(FallbackFont {
+                path: font.filename()?.into(),
+                index: font.face_index().unwrap_or(0) as u32,
+                font: OnceLock::new(),
+            })
+        })
+        .collect()
+});
+
+fn title_font(c: char) -> &'static FontArc {
+    if FONT.glyph_id(c).0 != 0 {
+        return &FONT;
+    }
+    #[cfg(feature = "fontconfig")]
+    for fallback in FALLBACK_FONTS.iter() {
+        let font = fallback.font.get_or_init(|| {
+            FontVec::try_from_vec_and_index(std::fs::read(&fallback.path).ok()?, fallback.index)
+                .ok()
+                .map(FontArc::from)
+        });
+        if let Some(font) = font {
+            if font.glyph_id(c).0 != 0 {
+                return font;
+            }
+        }
+    }
+    &FONT
+}
